<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${not ( sessionScope.rol eq 'COORDINACION' or sessionScope.rol eq 'ESTUDIANTE' or sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'EVALUADOR' )}"><c:redirect url="/panel.jsp"/></c:if>

<sql:query var="regs" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.estado,p.calificacion,p.actualizado_en,s.nombre AS estudiante,d.nombre AS director,e.nombre AS evaluador FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id LEFT JOIN parcial_julian.usuarios d ON d.id=p.director_id LEFT JOIN parcial_julian.usuarios e ON e.id=p.evaluador_id WHERE (CAST(? AS TEXT)='COORDINACION' OR (CAST(? AS TEXT)='ESTUDIANTE' AND p.estudiante_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT))) ORDER BY p.actualizado_en DESC LIMIT 200
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Expedientes académicos"/><c:set var="subtitulo" value="Búsqueda y seguimiento de anteproyectos según los permisos de tu perfil."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<section class="panel"><div class="search-line"><h2>Anteproyectos registrados <span class="chip"><c:out value="${regs.rowCount}"/></span></h2><label>Filtrar registros<input type="search" data-table-search="tablaProyectos" placeholder="Código, título, estado o estudiante"/></label></div><div class="table-wrap"><table id="tablaProyectos"><thead><tr><th>Código</th><th>Título</th><th>Estudiante</th><th>Director / evaluador</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${regs.rows}" var="r"><tr><td><strong><c:out value="${r.codigo}" default="Pendiente"/></strong></td><td><c:out value="${r.titulo}"/></td><td><c:out value="${r.estudiante}"/></td><td><c:out value="${r.director}" default="Por asignar"/> / <c:out value="${r.evaluador}" default="Por asignar"/></td><td><span class="chip ${r.estado eq 'APROBADO'?'green':'gray'}"><c:out value="${r.estado}"/></span></td><td class="actions"><a class="btn small" href="<c:url value='/detalle.jsp'><c:param name='id' value='${r.id}'/></c:url>">Expediente</a><a class="btn small" href="<c:url value='/seguimiento.jsp'><c:param name='id' value='${r.id}'/></c:url>">Seguimiento</a></td></tr></c:forEach></tbody></table></div><c:if test="${regs.rowCount eq 0}"><p class="empty-note">No hay expedientes autorizados para este perfil todavía.</p></c:if></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>
