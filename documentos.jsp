<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<sql:query var="acceso" dataSource="${db}">SELECT id,estudiante_id,director_id,evaluador_id,titulo,estado FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT) AND (CAST(? AS TEXT)='COORDINACION' OR (CAST(? AS TEXT)='ESTUDIANTE' AND estudiante_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='DIRECTOR' AND director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND evaluador_id=CAST(? AS BIGINT)))<sql:param value="${empty param.id?'0':param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:if test="${acceso.rowCount eq 0}"><c:redirect url="/panel.jsp"/></c:if>
<c:set var="p" value="${acceso.rows[0]}"/>
<c:if test="${pageContext.request.method eq 'POST' and sessionScope.csrf eq param.csrf and (sessionScope.rol eq 'ESTUDIANTE' or sessionScope.rol eq 'DIRECTOR')}"><c:catch var="errorGuardar">
<c:if test="${not fn:startsWith(param.url,'https://')}"><c:set var="errorUrl" value="true"/></c:if>
<c:if test="${empty errorUrl}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.documentos(anteproyecto_id,tipo,nombre,url,version,usuario_id) VALUES(CAST(? AS BIGINT),?,?,?,CAST(? AS INTEGER),CAST(? AS BIGINT))<sql:param value="${p.id}"/><sql:param value="${param.tipo}"/><sql:param value="${param.nombre}"/><sql:param value="${param.url}"/><sql:param value="${param.version}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),'Documento registrado',?)<sql:param value="${p.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.nombre}"/></sql:update></c:if></c:catch><c:if test="${empty errorUrl and empty errorGuardar}"><c:redirect url="/documentos.jsp"><c:param name="id" value="${p.id}"/><c:param name="ok" value="1"/></c:redirect></c:if></c:if>
<sql:query var="docs" dataSource="${db}">SELECT a.*,u.nombre AS autor FROM parcial_julian.documentos a LEFT JOIN parcial_julian.usuarios u ON u.id=a.usuario_id WHERE a.anteproyecto_id=CAST(? AS BIGINT) ORDER BY a.fecha DESC<sql:param value="${p.id}"/></sql:query>
<c:set var="titulo" value="Documentos del anteproyecto"/><c:set var="subtitulo" value="Enlaces de evidencias registrados, con responsable, tipo y versión."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${param.ok eq '1'}"><div class="alert good">Documento registrado en el expediente.</div></c:if><c:if test="${not empty errorGuardar or not empty errorUrl}"><div class="alert bad">La dirección debe comenzar por https:// y todos los campos deben ser válidos.</div></c:if>
<c:if test="${sessionScope.rol eq 'ESTUDIANTE' or sessionScope.rol eq 'DIRECTOR'}"><section class="panel"><h2>Registrar evidencia documental</h2><p class="muted">Para esta versión se registra un enlace HTTPS a un archivo, no una subida física a la base de datos.</p><form class="form-grid" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="id" value="${p.id}"/><label>Tipo<select name="tipo"><option value="PROPUESTA">Propuesta</option><option value="SOPORTE">Soporte</option><option value="INFORME">Informe de avance</option><option value="ACTA">Acta</option><option value="OTRO">Otro documento</option></select></label><label>Versión<input type="number" name="version" min="1" max="99" value="1" required/></label><label>Nombre<input name="nombre" maxlength="160" required/></label><label>URL segura<input type="url" name="url" maxlength="900" required pattern="https://.*" placeholder="https://drive.google.com/…"/></label><div class="span2"><button class="primary">Guardar enlace</button></div></form></section></c:if>
<section class="panel"><h2>Archivos y soportes registrados</h2><div class="table-wrap"><table><thead><tr><th>Documento</th><th>Tipo</th><th>Versión</th><th>Responsable</th><th>Fecha</th><th>Acción</th></tr></thead><tbody><c:forEach items="${docs.rows}" var="d"><tr><td><c:out value="${d.nombre}"/></td><td><span class="chip"><c:out value="${d.tipo}"/></span></td><td><c:out value="${d.version}"/></td><td><c:out value="${d.autor}"/></td><td><fmt:formatDate value="${d.fecha}" pattern="dd/MM/yyyy"/></td><td><a class="btn small" href="<c:out value='${d.url}'/>" rel="noopener noreferrer" target="_blank">Abrir ↗</a></td></tr></c:forEach></tbody></table></div><c:if test="${docs.rowCount eq 0}"><div class="empty-note">Aún no hay documentos registrados en este expediente.</div></c:if></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>
