<!-- Tres registros académicos de demostración para probar el rol Director -->
<sql:update>INSERT INTO parcial_julian.practicas(estudiante_id,tutor_id,empresa,area,supervisor,titulo,objetivo,inicio,fin,estado)
SELECT s.id,t.id,'Centro de Servicios Digitales','Desarrollo de software','Responsable de área','Innovación y soporte de sistemas académicos','Registrar requerimientos, organizar sprints y documentar ajustes de un sistema de gestión académica.',DATE '2026-08-10',DATE '2026-12-04','EN_CURSO'
FROM parcial_julian.usuarios s CROSS JOIN parcial_julian.usuarios t WHERE s.correo='julian.lache@ejemplo.test' AND t.correo='director.julian@ejemplo.test'
AND NOT EXISTS (SELECT 1 FROM parcial_julian.practicas p WHERE p.estudiante_id=s.id AND p.titulo='Innovación y soporte de sistemas académicos')</sql:update>
<sql:update>INSERT INTO parcial_julian.practicas(estudiante_id,tutor_id,empresa,area,supervisor,titulo,objetivo,inicio,fin,estado)
SELECT s.id,t.id,'Unidad de Tecnología Aplicada','Infraestructura y redes','Responsable de área','Gestión de infraestructura y soporte','Apoyar inventarios tecnológicos y elaborar un plan de mantenimiento preventivo.',DATE '2026-08-10',DATE '2026-12-04','APROBADA'
FROM parcial_julian.usuarios s CROSS JOIN parcial_julian.usuarios t WHERE s.correo='julian.lache@ejemplo.test' AND t.correo='director.julian@ejemplo.test'
AND NOT EXISTS (SELECT 1 FROM parcial_julian.practicas p WHERE p.estudiante_id=s.id AND p.titulo='Gestión de infraestructura y soporte')</sql:update>
<sql:update>INSERT INTO parcial_julian.practicas(estudiante_id,tutor_id,empresa,area,supervisor,titulo,objetivo,inicio,fin,estado)
SELECT s.id,t.id,'Laboratorio de Información','Analítica de datos','Responsable de área','Automatización de reportes institucionales','Construir informes y paneles para el seguimiento de indicadores de atención.',DATE '2026-08-10',DATE '2026-12-04','INFORME_ENTREGADO'
FROM parcial_julian.usuarios s CROSS JOIN parcial_julian.usuarios t WHERE s.correo='julian.lache@ejemplo.test' AND t.correo='director.julian@ejemplo.test'
AND NOT EXISTS (SELECT 1 FROM parcial_julian.practicas p WHERE p.estudiante_id=s.id AND p.titulo='Automatización de reportes institucionales')</sql:update>
