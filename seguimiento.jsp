<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<sql:query var="exp" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.estado,p.estudiante_id,p.director_id,p.evaluador_id,p.calificacion,p.actualizado_en, (SELECT COUNT(*) FROM parcial_julian.revisiones r WHERE r.anteproyecto_id=p.id AND r.tipo='DIRECTOR' AND r.decision='APROBADO') AS aval_director, (SELECT COUNT(*) FROM parcial_julian.revisiones r WHERE r.anteproyecto_id=p.id AND r.tipo='EVALUADOR') AS conceptos, (SELECT COUNT(*) FROM parcial_julian.decisiones d WHERE d.anteproyecto_id=p.id) AS cierres FROM parcial_julian.anteproyectos p WHERE p.id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT) AND (CAST(? AS TEXT) IN ('ADMINISTRADOR','COORDINACION') OR (CAST(? AS TEXT)='ESTUDIANTE' AND p.estudiante_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT)))
<sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:if test="${exp.rowCount eq 0}"><c:redirect url="/proyectos.jsp"/></c:if><c:set var="p" value="${exp.rows[0]}"/>
<c:set var="entregado" value="${p.estado ne 'BORRADOR' and p.estado ne 'SIN_DIRECTOR'}"/><c:set var="directorAval" value="${p.aval_director gt 0}"/><c:set var="evaluado" value="${p.conceptos gt 0}"/><c:set var="cerrado" value="${p.cierres gt 0}"/>
<c:set var="titulo" value="Ruta del anteproyecto"/><c:set var="subtitulo" value="Consulta las etapas del proceso y los movimientos registrados para este expediente."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<section class="panel journey-panel"><div class="journey-header"><div><span class="eyebrow accent">EXPEDIENTE <c:out value="${p.codigo}" default="SIN CÓDIGO"/></span><h2><c:out value="${p.titulo}"/></h2><p>Avance del anteproyecto desde la idea hasta la decisión académica.</p></div><span class="chip ${cerrado ? 'green' : 'gray'}"><c:out value="${p.estado}"/></span></div>
<div class="journey-track" aria-label="Etapas del anteproyecto">
<div class="journey-step finished"><div class="journey-dot">01</div><span class="journey-meta">Registro</span><h3>Idea y propuesta</h3><p>El estudiante identifica el tema y crea su expediente.</p><span class="journey-status">Registrada</span></div>
<div class="journey-step ${entregado?'finished': 'waiting'}"><div class="journey-dot">02</div><span class="journey-meta">Entrega</span><h3>Presentación</h3><p>Envío del anteproyecto para revisión académica.</p><span class="journey-status">${entregado?'Enviada':'Pendiente'}</span></div>
<div class="journey-step ${directorAval?'finished':entregado?'in-progress':'waiting'}"><div class="journey-dot">03</div><span class="journey-meta">Revisión</span><h3>Concepto Director</h3><p>Observaciones, calificación y aval de la propuesta.</p><span class="journey-status">${directorAval?'Aval registrado':entregado?'En revisión':'Pendiente'}</span></div>
<div class="journey-step ${evaluado?'finished':directorAval?'in-progress':'waiting'}"><div class="journey-dot">04</div><span class="journey-meta">Evaluación</span><h3>Concepto Evaluador</h3><p>Valoración de la propuesta después del aval.</p><span class="journey-status">${evaluado?'Evaluado':directorAval?'En evaluación':'Pendiente'}</span></div>
<div class="journey-step ${cerrado?'finished':evaluado?'in-progress':'waiting'}"><div class="journey-dot">05</div><span class="journey-meta">Cierre</span><h3>Coordinación</h3><p>Concepto, acta y cierre del proceso académico.</p><span class="journey-status">${cerrado?'Decisión registrada':evaluado?'Por definir':'Pendiente'}</span></div>
</div><div class="journey-footer"><div><small>Última actualización</small><strong><fmt:formatDate value="${p.actualizado_en}" pattern="dd/MM/yyyy HH:mm"/></strong></div><div><small>Calificación</small><strong><c:choose><c:when test="${not empty p.calificacion}"><c:out value="${p.calificacion}"/> / 5</c:when><c:otherwise>Por evaluar</c:otherwise></c:choose></strong></div><div class="journey-links"><a class="btn primary" href="<c:url value='/detalle.jsp'><c:param name='id' value='${p.id}'/></c:url>">Ver expediente</a><a class="btn" href="<c:url value='/documentos.jsp'><c:param name='id' value='${p.id}'/></c:url>">Documentos</a><a class="btn ghost" href="<c:url value='/proyectos.jsp'/>">Volver</a></div></div></section>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
