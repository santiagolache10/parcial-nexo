<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:set var="rolNecesario" value="COORDINACION"/><%@ include file="/WEB-INF/jspf/roles.jspf" %>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and (empty param.director or empty param.evaluador or param.director ne param.evaluador) and param.accion eq 'asignar'}"><c:catch var="errorAsignacion">
<sql:update var="numero" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET director_id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),evaluador_id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),estado=CASE WHEN estado='SIN_DIRECTOR' AND CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT) IS NOT NULL THEN 'PENDIENTE_DIRECTOR' ELSE estado END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT)
<sql:param value="${param.director}"/><sql:param value="${param.evaluador}"/><sql:param value="${param.director}"/><sql:param value="${param.id}"/></sql:update>
<c:if test="${numero gt 0}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="asignaciones"/><sql:param value="${param.accion}"/><sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),'Asignación de responsables','Coordinación actualizó director y/o evaluador.')<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:if></c:catch><c:if test="${empty errorAsignacion}"><c:redirect url="/asignaciones.jsp?ok=1"/></c:if></c:if>
<sql:query var="proyectos" dataSource="${db}">SELECT p.id,p.titulo,p.estado,p.director_id,p.evaluador_id,s.nombre AS estudiante FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id ORDER BY p.id DESC</sql:query>
<sql:query var="directores" dataSource="${db}">SELECT id,nombre FROM parcial_julian.usuarios WHERE rol='DIRECTOR' AND activo=TRUE ORDER BY nombre</sql:query>
<sql:query var="evaluadores" dataSource="${db}">SELECT id,nombre FROM parcial_julian.usuarios WHERE rol='EVALUADOR' AND activo=TRUE ORDER BY nombre</sql:query>
<c:set var="titulo" value="Asignación de docentes"/><c:set var="subtitulo" value="Asocia un director y un evaluador al anteproyecto correspondiente."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${param.ok eq '1'}"><div class="alert good">Asignación guardada.</div></c:if><c:if test="${not empty errorAsignacion}"><div class="alert bad">No se pudo asignar. Comprueba los perfiles seleccionados.</div></c:if>
<div class="panel"><h2>Anteproyectos y responsables</h2><div class="table-wrap"><table><thead><tr><th>Anteproyecto</th><th>Estudiante</th><th>Estado</th><th>Asignación</th></tr></thead><tbody>
<c:forEach items="${proyectos.rows}" var="p"><tr><td><strong><c:out value="${p.titulo}"/></strong></td><td><c:out value="${p.estudiante}"/></td><td><span class="chip"><c:out value="${p.estado}"/></span></td><td><form class="actions" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="asignar"><input type="hidden" name="id" value="${p.id}"><select name="director"><option value="">Sin director</option><c:forEach items="${directores.rows}" var="u"><option value="${u.id}" ${u.id eq p.director_id ? 'selected':''}><c:out value="${u.nombre}"/></option></c:forEach></select><select name="evaluador"><option value="">Sin evaluador</option><c:forEach items="${evaluadores.rows}" var="u"><option value="${u.id}" ${u.id eq p.evaluador_id ? 'selected':''}><c:out value="${u.nombre}"/></option></c:forEach></select><button class="primary small" type="submit">Asignar</button><a class="btn small" href="<c:url value='/detalle.jsp'><c:param name='id' value='${p.id}'/></c:url>">Ver</a></form></td></tr></c:forEach><c:if test="${proyectos.rowCount eq 0}"><tr><td colspan="4">No hay anteproyectos registrados todavía.</td></tr></c:if></tbody></table></div></div>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
