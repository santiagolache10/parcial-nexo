<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${not ( sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'EVALUADOR' )}"><c:redirect url="/panel.jsp"/></c:if>

<c:if test="${pageContext.request.method eq 'POST' and param.csrf eq sessionScope.csrf and not empty param.id and not empty param.criterio}"><c:catch var="errorGuardar"><sql:update dataSource="${db}">INSERT INTO parcial_julian.notas_criterios(anteproyecto_id,criterio_id,evaluador_id,cumple,observacion) SELECT p.id,CAST(? AS BIGINT),CAST(? AS BIGINT),CAST(? AS BOOLEAN),? FROM parcial_julian.anteproyectos p WHERE p.id=CAST(? AS BIGINT) AND ((CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT) AND p.estado='PENDIENTE_DIRECTOR') OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT) AND p.estado='PENDIENTE_EVALUADOR')) ON CONFLICT(anteproyecto_id,criterio_id,evaluador_id) DO UPDATE SET cumple=EXCLUDED.cumple,observacion=EXCLUDED.observacion,fecha=CURRENT_TIMESTAMP
<sql:param value="${param.criterio}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.cumple}"/><sql:param value="${param.comentario}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:catch><c:if test="${empty errorGuardar}"><c:redirect url="/rubrica.jsp"><c:param name="id" value="${param.id}"/><c:param name="ok" value="1"/></c:redirect></c:if></c:if>
<sql:query var="proyectos" dataSource="${db}">SELECT id,titulo,estado FROM parcial_julian.anteproyectos WHERE (CAST(? AS TEXT)='DIRECTOR' AND director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND evaluador_id=CAST(? AS BIGINT)) ORDER BY actualizado_en DESC LIMIT 100<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<sql:query var="criterios" dataSource="${db}">SELECT c.id,c.nombre,c.obligatorio,n.cumple,n.observacion FROM parcial_julian.criterios c LEFT JOIN parcial_julian.notas_criterios n ON n.criterio_id=c.id AND n.anteproyecto_id=CAST(? AS BIGINT) AND n.evaluador_id=CAST(? AS BIGINT) ORDER BY c.id<sql:param value="${empty param.id?'0':param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Rejilla de evaluación"/><c:set var="subtitulo" value="Revisión por criterios con observaciones independientes."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="panel"><h2>Seleccionar anteproyecto</h2><form method="get" class="actions"><select name="id"><c:forEach items="${proyectos.rows}" var="p"><option value="${p.id}" ${param.id eq p.id ? 'selected':''}><c:out value="${p.titulo}"/> · <c:out value="${p.estado}"/></option></c:forEach></select><button class="primary">Consultar rejilla</button></form></div>
<c:if test="${not empty param.id}"><section class="panel"><h2>Criterios de revisión</h2><c:if test="${not empty errorGuardar}"><div class="alert bad">No se guardó la evaluación. Confirma la asignación y el estado del expediente.</div></c:if><c:forEach items="${criterios.rows}" var="c"><form method="post" class="link-card"><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="id" value="<c:out value='${param.id}'/>"/><input type="hidden" name="criterio" value="${c.id}"/><div style="flex:1"><strong><c:out value="${c.nombre}"/></strong><div class="actions" style="margin-top:8px"><label>Cumplimiento<select name="cumple"><option value="true" ${c.cumple eq true?'selected':''}>Cumple</option><option value="false" ${c.cumple eq false?'selected':''}>Debe ajustar</option></select></label><label style="flex:1">Observación<input name="comentario" maxlength="900" value="<c:out value='${c.observacion}'/>" placeholder="Observaciones del criterio"/></label></div></div><button class="btn small" type="submit">Guardar</button></form></c:forEach></section></c:if><%@ include file="/WEB-INF/jspf/pie.jspf" %>
