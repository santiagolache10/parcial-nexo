<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'COORDINACION' and sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/panel.jsp"/></c:if>
<c:if test="${sessionScope.rol eq 'COORDINACION' and pageContext.request.method eq 'POST' and param.csrf eq sessionScope.csrf}"><c:catch var="falloIdea"><c:choose>
<c:when test="${param.accion eq 'crear'}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.ideas(titulo,objetivo,descripcion,creado_por,nivel,modalidad,desde,hasta) VALUES(?,?,?,CAST(? AS BIGINT),?,?,CAST(NULLIF(CAST(? AS TEXT),'') AS DATE),CAST(NULLIF(CAST(? AS TEXT),'') AS DATE))<sql:param value="${param.titulo}"/><sql:param value="${param.objetivo}"/><sql:param value="${param.descripcion}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.nivel}"/><sql:param value="${param.modalidad}"/><sql:param value="${param.desde}"/><sql:param value="${param.hasta}"/></sql:update></c:when>
<c:when test="${param.accion eq 'editar'}"><sql:update dataSource="${db}">UPDATE parcial_julian.ideas SET titulo=?,objetivo=?,descripcion=?,estado=?,nivel=?,modalidad=?,desde=CAST(NULLIF(CAST(? AS TEXT),'') AS DATE),hasta=CAST(NULLIF(CAST(? AS TEXT),'') AS DATE) WHERE id=CAST(? AS BIGINT)<sql:param value="${param.titulo}"/><sql:param value="${param.objetivo}"/><sql:param value="${param.descripcion}"/><sql:param value="${param.estado}"/><sql:param value="${param.nivel}"/><sql:param value="${param.modalidad}"/><sql:param value="${param.desde}"/><sql:param value="${param.hasta}"/><sql:param value="${param.id}"/></sql:update></c:when>
<c:when test="${param.accion eq 'eliminar'}"><sql:update dataSource="${db}">DELETE FROM parcial_julian.ideas WHERE id=CAST(? AS BIGINT) AND NOT EXISTS (SELECT 1 FROM parcial_julian.anteproyectos WHERE idea_id=CAST(? AS BIGINT))<sql:param value="${param.id}"/><sql:param value="${param.id}"/></sql:update></c:when>
<c:when test="${param.accion eq 'cerrar'}"><sql:update dataSource="${db}">UPDATE parcial_julian.ideas SET estado='CERRADA' WHERE id=CAST(? AS BIGINT)<sql:param value="${param.id}"/></sql:update></c:when></c:choose><sql:update dataSource="${db}">INSERT INTO parcial_julian.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="ideas"/><sql:param value="${param.accion}"/><sql:param value="${param.titulo}"/></sql:update></c:catch>
<c:if test="${empty falloIdea}"><c:redirect url="/ideas.jsp?ok=1"/></c:if></c:if>
<sql:query var="ideas" dataSource="${db}">SELECT i.*,u.nombre AS autor FROM parcial_julian.ideas i LEFT JOIN parcial_julian.usuarios u ON u.id=i.creado_por WHERE (CAST(? AS TEXT)='COORDINACION' OR (i.estado='DISPONIBLE' AND (i.desde IS NULL OR i.desde<=CURRENT_DATE) AND (i.hasta IS NULL OR i.hasta>=CURRENT_DATE))) ORDER BY i.id DESC<sql:param value="${sessionScope.rol}"/></sql:query>
<c:if test="${sessionScope.rol eq 'COORDINACION' and not empty param.editar}"><sql:query var="edicion" dataSource="${db}">SELECT * FROM parcial_julian.ideas WHERE id=CAST(? AS BIGINT)<sql:param value="${param.editar}"/></sql:query></c:if>
<c:set var="titulo" value="Banco de ideas"/><c:set var="subtitulo" value="${sessionScope.rol eq 'ESTUDIANTE' ? 'Escoge una idea disponible e inicia tu anteproyecto.' : 'Crea y administra las ideas del sistema académico.'}"/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${not empty falloIdea}"><div class="alert bad">No fue posible guardar la idea. Revisa los datos.</div></c:if><c:if test="${param.ok eq '1'}"><div class="alert good">Operación completada.</div></c:if>
<c:if test="${sessionScope.rol eq 'COORDINACION'}"><div class="panel"><h2>${edicion.rowCount gt 0 ? 'Modificar idea':'Nueva idea de anteproyecto'}</h2><form class="form-grid" method="post">
<input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="${edicion.rowCount gt 0 ? 'editar':'crear'}"><input type="hidden" name="id" value="${edicion.rows[0].id}">
<label>Título<input required name="titulo" maxlength="220" value="<c:out value='${edicion.rows[0].titulo}'/>"></label><label>Estado<select name="estado"><option value="DISPONIBLE">Disponible</option><option value="CERRADA" ${edicion.rows[0].estado eq 'CERRADA' ? 'selected' : ''}>Cerrada</option></select></label>
<label>Nivel académico<select name="nivel"><option value="">Todos</option><option value="TECNOLOGICO" ${edicion.rows[0].nivel eq 'TECNOLOGICO'?'selected':''}>Tecnológico</option><option value="PROFESIONAL" ${edicion.rows[0].nivel eq 'PROFESIONAL'?'selected':''}>Profesional</option></select></label>
<label>Modalidad<select name="modalidad"><option value="DESARROLLO TECNOLOGICO">Desarrollo Tecnológico</option><option value="PROYECTO DE INVESTIGACION">Proyecto de Investigación</option><option value="MONOGRAFIA">Monografía</option><option value="PRACTICA">Práctica</option></select></label>
<label>Disponible desde<input type="date" name="desde" value="${edicion.rows[0].desde}"/></label><label>Hasta<input type="date" name="hasta" value="${edicion.rows[0].hasta}"/></label>
<label class="span2">Objetivo<textarea name="objetivo" required rows="2"><c:out value="${edicion.rows[0].objetivo}"/></textarea></label><label class="span2">Descripción<textarea name="descripcion" required rows="3"><c:out value="${edicion.rows[0].descripcion}"/></textarea></label>
<div class="span2 actions"><button type="submit" class="primary">Guardar idea</button><c:if test="${edicion.rowCount gt 0}"><a class="btn ghost" href="<c:url value='/ideas.jsp'/>">Cancelar</a></c:if></div></form></div></c:if>
<div class="panel"><div class="search-line"><h2>Ideas registradas</h2><label>Buscar<input type="search" data-table-search="ideasTabla" placeholder="Título o tema"/></label></div><div class="table-wrap"><table id="ideasTabla"><thead><tr><th>Idea</th><th>Objetivo</th><th>Modalidad</th><th>Estado</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${ideas.rows}" var="i"><tr><td><strong><c:out value="${i.titulo}"/></strong><small class="muted">#IDEA-<c:out value="${i.id}"/> · <c:out value="${i.autor}"/></small></td><td><c:out value="${i.objetivo}"/></td><td><c:out value="${i.modalidad}" default="Por definir"/></td><td><span class="chip ${i.estado eq 'DISPONIBLE' ? 'green':'gray'}"><c:out value="${i.estado}"/></span></td><td class="actions">
<c:if test="${sessionScope.rol eq 'ESTUDIANTE' and i.estado eq 'DISPONIBLE'}"><a class="btn primary small" href="<c:url value='/anteproyectos.jsp'><c:param name='idea' value='${i.id}'/></c:url>">Elegir idea →</a></c:if>
<c:if test="${sessionScope.rol eq 'COORDINACION'}"><a class="btn small" href="<c:url value='/ideas.jsp'><c:param name='editar' value='${i.id}'/></c:url>">Editar</a><form method="post" class="inline" data-confirm="¿Eliminar esta idea? Si ya está vinculada a un anteproyecto no se eliminará."><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="accion" value="eliminar"/><input type="hidden" name="id" value="${i.id}"/><button type="submit" class="btn small danger">Eliminar</button></form><c:if test="${i.estado eq 'DISPONIBLE'}"><form method="post" class="inline" data-confirm="¿Cerrar esta idea?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="cerrar"><input type="hidden" name="id" value="${i.id}"><button type="submit" class="btn danger small">Cerrar</button></form></c:if></c:if></td></tr></c:forEach></tbody></table></div></div>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
