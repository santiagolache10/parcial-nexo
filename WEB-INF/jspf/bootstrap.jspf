<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/conexion.jspf" %>
<c:if test="${applicationScope.nexoInicializado ne true}">
<c:catch var="inicializacionError">
<sql:transaction dataSource="${db}">
<sql:update>CREATE SCHEMA IF NOT EXISTS parcial_julian</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.usuarios (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, nombre VARCHAR(160) NOT NULL, correo VARCHAR(180) UNIQUE NOT NULL, rol VARCHAR(24) NOT NULL CHECK (rol IN ('ADMINISTRADOR','COORDINACION','DIRECTOR','EVALUADOR','ESTUDIANTE')), programa VARCHAR(150), sal VARCHAR(32) NOT NULL, clave_hash CHAR(64) NOT NULL, activo BOOLEAN NOT NULL DEFAULT TRUE, creado_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.ideas (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, titulo VARCHAR(220) NOT NULL, objetivo TEXT NOT NULL, descripcion TEXT NOT NULL, estado VARCHAR(24) NOT NULL DEFAULT 'DISPONIBLE' CHECK (estado IN ('DISPONIBLE','CERRADA')), creado_por BIGINT REFERENCES parcial_julian.usuarios(id), creado_en TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.anteproyectos (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, codigo VARCHAR(28) UNIQUE, idea_id BIGINT REFERENCES parcial_julian.ideas(id), estudiante_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id), director_id BIGINT REFERENCES parcial_julian.usuarios(id), evaluador_id BIGINT REFERENCES parcial_julian.usuarios(id), titulo VARCHAR(220) NOT NULL, resumen TEXT NOT NULL, objetivos TEXT NOT NULL, enlace_archivo VARCHAR(900), estado VARCHAR(30) NOT NULL DEFAULT 'BORRADOR', calificacion NUMERIC(3,2), creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.revisiones (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), revisor_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id), tipo VARCHAR(16) NOT NULL CHECK(tipo IN ('DIRECTOR','EVALUADOR')), decision VARCHAR(22) NOT NULL, nota NUMERIC(3,2) CHECK(nota BETWEEN 0 AND 5), observaciones TEXT NOT NULL, fecha TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.calendario (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, evento VARCHAR(220) NOT NULL, inicio DATE NOT NULL, fin DATE NOT NULL, CHECK (fin>=inicio))</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.formatos (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, nombre VARCHAR(220) NOT NULL UNIQUE, version VARCHAR(90) NOT NULL, url VARCHAR(900) NOT NULL)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.historial (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), actor_id BIGINT REFERENCES parcial_julian.usuarios(id), evento VARCHAR(140) NOT NULL, detalle TEXT, fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_estudiante ON parcial_julian.anteproyectos(estudiante_id,estado)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_director ON parcial_julian.anteproyectos(director_id,estado)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_evaluador ON parcial_julian.anteproyectos(evaluador_id,estado)</sql:update>
<sql:update>INSERT INTO parcial_julian.usuarios (nombre,correo,rol,programa,sal,clave_hash) SELECT 'Administrador académico','admin.julian@ejemplo.test','ADMINISTRADOR','Ingeniería de Sistemas',md5('admin.julian@ejemplo.test'),encode(sha256(convert_to(md5('admin.julian@ejemplo.test') || 'Julian2026UTS!', 'UTF8')),'hex') WHERE NOT EXISTS (SELECT 1 FROM parcial_julian.usuarios WHERE correo='admin.julian@ejemplo.test')</sql:update>
<sql:update>INSERT INTO parcial_julian.usuarios (nombre,correo,rol,programa,sal,clave_hash) SELECT 'Coordinación académica','coordinacion.julian@ejemplo.test','COORDINACION','Ingeniería de Sistemas',md5('coordinacion.julian@ejemplo.test'),encode(sha256(convert_to(md5('coordinacion.julian@ejemplo.test') || 'Julian2026UTS!', 'UTF8')),'hex') WHERE NOT EXISTS (SELECT 1 FROM parcial_julian.usuarios WHERE correo='coordinacion.julian@ejemplo.test')</sql:update>
<sql:update>INSERT INTO parcial_julian.usuarios (nombre,correo,rol,programa,sal,clave_hash) SELECT 'Docente Director','director.julian@ejemplo.test','DIRECTOR','Ingeniería de Sistemas',md5('director.julian@ejemplo.test'),encode(sha256(convert_to(md5('director.julian@ejemplo.test') || 'Julian2026UTS!', 'UTF8')),'hex') WHERE NOT EXISTS (SELECT 1 FROM parcial_julian.usuarios WHERE correo='director.julian@ejemplo.test')</sql:update>
<sql:update>INSERT INTO parcial_julian.usuarios (nombre,correo,rol,programa,sal,clave_hash) SELECT 'Docente Evaluador','evaluador.julian@ejemplo.test','EVALUADOR','Ingeniería de Sistemas',md5('evaluador.julian@ejemplo.test'),encode(sha256(convert_to(md5('evaluador.julian@ejemplo.test') || 'Julian2026UTS!', 'UTF8')),'hex') WHERE NOT EXISTS (SELECT 1 FROM parcial_julian.usuarios WHERE correo='evaluador.julian@ejemplo.test')</sql:update>
<sql:update>INSERT INTO parcial_julian.usuarios (nombre,correo,rol,programa,sal,clave_hash) SELECT 'Julián Santiago Lache Leguízamo','julian.lache@ejemplo.test','ESTUDIANTE','Ingeniería de Sistemas',md5('julian.lache@ejemplo.test'),encode(sha256(convert_to(md5('julian.lache@ejemplo.test') || 'Julian2026UTS!', 'UTF8')),'hex') WHERE NOT EXISTS (SELECT 1 FROM parcial_julian.usuarios WHERE correo='julian.lache@ejemplo.test')</sql:update>
<sql:update>INSERT INTO parcial_julian.ideas(titulo,objetivo,descripcion,creado_por) SELECT 'Plataforma de seguimiento académico','Mejorar el control de entregas y observaciones','Aplicación para organizar propuestas, revisiones y responsables.',(SELECT id FROM parcial_julian.usuarios WHERE rol='COORDINACION' LIMIT 1) WHERE NOT EXISTS(SELECT 1 FROM parcial_julian.ideas WHERE titulo='Plataforma de seguimiento académico')</sql:update>
<sql:update>INSERT INTO parcial_julian.ideas(titulo,objetivo,descripcion,creado_por) SELECT 'Sistema de gestión de inventarios','Automatizar la trazabilidad de productos','Sistema web con reportes, responsables e indicadores.',(SELECT id FROM parcial_julian.usuarios WHERE rol='COORDINACION' LIMIT 1) WHERE NOT EXISTS(SELECT 1 FROM parcial_julian.ideas WHERE titulo='Sistema de gestión de inventarios')</sql:update>
<sql:update>INSERT INTO parcial_julian.calendario(evento,inicio,fin) SELECT 'Presentación de anteproyectos',DATE '2026-10-01',DATE '2026-11-15' WHERE NOT EXISTS(SELECT 1 FROM parcial_julian.calendario WHERE evento='Presentación de anteproyectos')</sql:update>
<sql:update>INSERT INTO parcial_julian.calendario(evento,inicio,fin) SELECT 'Revisión académica',DATE '2026-11-16',DATE '2026-12-05' WHERE NOT EXISTS(SELECT 1 FROM parcial_julian.calendario WHERE evento='Revisión académica')</sql:update>
<sql:update>INSERT INTO parcial_julian.formatos(nombre,version,url) VALUES('Repositorio institucional de formatos de grado UTS','Consultar versión vigente','https://www.uts.edu.co/portal-academico/') ON CONFLICT(nombre) DO NOTHING</sql:update>

<sql:update>ALTER TABLE parcial_julian.usuarios ADD COLUMN IF NOT EXISTS identificacion VARCHAR(35)</sql:update>
<sql:update>ALTER TABLE parcial_julian.usuarios ADD COLUMN IF NOT EXISTS nivel VARCHAR(45)</sql:update>
<sql:update>ALTER TABLE parcial_julian.usuarios ADD COLUMN IF NOT EXISTS plan VARCHAR(40)</sql:update>
<sql:update>ALTER TABLE parcial_julian.usuarios ADD COLUMN IF NOT EXISTS creditos SMALLINT DEFAULT 0</sql:update>
<sql:update>ALTER TABLE parcial_julian.usuarios ADD COLUMN IF NOT EXISTS metodologia BOOLEAN DEFAULT FALSE</sql:update>
<sql:update>ALTER TABLE parcial_julian.usuarios ADD COLUMN IF NOT EXISTS telefono VARCHAR(30)</sql:update>
<sql:update>ALTER TABLE parcial_julian.ideas ADD COLUMN IF NOT EXISTS nivel VARCHAR(45)</sql:update>
<sql:update>ALTER TABLE parcial_julian.ideas ADD COLUMN IF NOT EXISTS modalidad VARCHAR(80)</sql:update>
<sql:update>ALTER TABLE parcial_julian.ideas ADD COLUMN IF NOT EXISTS desde DATE</sql:update>
<sql:update>ALTER TABLE parcial_julian.ideas ADD COLUMN IF NOT EXISTS hasta DATE</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS justificacion TEXT</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS objetivos_especificos TEXT</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS resultados_esperados TEXT</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS modalidad VARCHAR(80) DEFAULT 'Desarrollo Tecnológico'</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS grupo_id BIGINT</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS linea_id BIGINT</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS periodo_id BIGINT</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS version_actual INTEGER NOT NULL DEFAULT 1</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS fecha_director TIMESTAMP</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS fecha_evaluador TIMESTAMP</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS etapa_actual VARCHAR(35) NOT NULL DEFAULT 'ANTEPROYECTO'</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS proyecto_final_url VARCHAR(900)</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS calificacion_final NUMERIC(3,2)</sql:update>
<sql:update>ALTER TABLE parcial_julian.anteproyectos ADD COLUMN IF NOT EXISTS version_final INTEGER NOT NULL DEFAULT 1</sql:update>
<!-- Compatibilidad: algunas bases antiguas tienen un CHECK de estado que bloquea los estados nuevos del proyecto final. -->
<sql:update>DO $nexo$ DECLARE restr RECORD; BEGIN FOR restr IN SELECT con.conname FROM pg_constraint con JOIN pg_class rel ON rel.oid=con.conrelid JOIN pg_namespace nsp ON nsp.oid=rel.relnamespace WHERE nsp.nspname='parcial_julian' AND rel.relname='anteproyectos' AND con.contype='c' AND pg_get_constraintdef(con.oid) ILIKE '%estado%' LOOP EXECUTE format('ALTER TABLE parcial_julian.anteproyectos DROP CONSTRAINT %I', restr.conname); END LOOP; END $nexo$</sql:update>
<sql:update>ALTER TABLE parcial_julian.revisiones ADD COLUMN IF NOT EXISTS etapa VARCHAR(35) NOT NULL DEFAULT 'ANTEPROYECTO'</sql:update>
<sql:update>UPDATE parcial_julian.anteproyectos SET etapa_actual='ANTEPROYECTO_APROBADO' WHERE estado='APROBADO' AND etapa_actual='ANTEPROYECTO'</sql:update> <!-- Migración de aprobaciones previas -->
<sql:update>ALTER TABLE parcial_julian.revisiones ADD COLUMN IF NOT EXISTS estado VARCHAR(20) NOT NULL DEFAULT 'EMITIDA'</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.periodos (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nombre VARCHAR(90) UNIQUE NOT NULL, inicio DATE NOT NULL, fin DATE NOT NULL, apertura_ideas DATE, cierre_ideas DATE, estado VARCHAR(24) NOT NULL DEFAULT 'ABIERTO')</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.grupos (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nombre VARCHAR(160) UNIQUE NOT NULL, activo BOOLEAN DEFAULT TRUE)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.lineas (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, grupo_id BIGINT NOT NULL REFERENCES parcial_julian.grupos(id), nombre VARCHAR(180) NOT NULL, activo BOOLEAN DEFAULT TRUE, UNIQUE(grupo_id,nombre))</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.integrantes (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), estudiante_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id), UNIQUE(anteproyecto_id,estudiante_id))</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.versiones (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), version INTEGER NOT NULL, titulo VARCHAR(220), resumen TEXT, objetivos TEXT, justificacion TEXT, archivo_url VARCHAR(900), autor_id BIGINT REFERENCES parcial_julian.usuarios(id), fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP, UNIQUE(anteproyecto_id,version))</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.documentos (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), tipo VARCHAR(90) NOT NULL, nombre VARCHAR(160) NOT NULL, url VARCHAR(900) NOT NULL, version INTEGER DEFAULT 1, usuario_id BIGINT REFERENCES parcial_julian.usuarios(id), fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.criterios (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, nombre VARCHAR(170) UNIQUE NOT NULL, obligatorio BOOLEAN DEFAULT TRUE)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.notas_criterios (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), criterio_id BIGINT NOT NULL REFERENCES parcial_julian.criterios(id), evaluador_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id), cumple BOOLEAN NOT NULL, observacion TEXT, fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP, UNIQUE(anteproyecto_id,criterio_id,evaluador_id))</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.decisiones (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, anteproyecto_id BIGINT NOT NULL REFERENCES parcial_julian.anteproyectos(id), coordinador_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id), decision VARCHAR(30) NOT NULL, acta VARCHAR(90), fecha_acta DATE, observaciones TEXT, fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.notificaciones (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, usuario_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id), anteproyecto_id BIGINT REFERENCES parcial_julian.anteproyectos(id), mensaje VARCHAR(500) NOT NULL, leida BOOLEAN DEFAULT FALSE, fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.auditoria (id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY, usuario_id BIGINT REFERENCES parcial_julian.usuarios(id), entidad VARCHAR(80) NOT NULL, entidad_id BIGINT, accion VARCHAR(100) NOT NULL, detalle TEXT, fecha TIMESTAMP DEFAULT CURRENT_TIMESTAMP)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_notif ON parcial_julian.notificaciones(usuario_id,leida,fecha)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_docs ON parcial_julian.documentos(anteproyecto_id,fecha)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_audit ON parcial_julian.auditoria(fecha)</sql:update>
<sql:update>INSERT INTO parcial_julian.periodos(nombre,inicio,fin,apertura_ideas,cierre_ideas,estado) VALUES ('2026-2',DATE '2026-07-01',DATE '2026-12-15',DATE '2026-08-01',DATE '2026-11-30','ABIERTO') ON CONFLICT(nombre) DO NOTHING</sql:update>
<sql:update>INSERT INTO parcial_julian.grupos(nombre) VALUES ('Grupo de Investigación en Software y Sistemas') ON CONFLICT(nombre) DO NOTHING</sql:update>
<sql:update>INSERT INTO parcial_julian.lineas(grupo_id,nombre) SELECT id,'Arquitectura y desarrollo de software' FROM parcial_julian.grupos WHERE nombre='Grupo de Investigación en Software y Sistemas' ON CONFLICT(grupo_id,nombre) DO NOTHING</sql:update>
<sql:update>INSERT INTO parcial_julian.lineas(grupo_id,nombre) SELECT id,'Sistemas de información y transformación digital' FROM parcial_julian.grupos WHERE nombre='Grupo de Investigación en Software y Sistemas' ON CONFLICT(grupo_id,nombre) DO NOTHING</sql:update>
<sql:update>INSERT INTO parcial_julian.criterios(nombre) VALUES ('Planteamiento del problema'),('Justificación'),('Objetivos verificables'),('Metodología coherente'),('Viabilidad y cronograma'),('Presentación y referencias') ON CONFLICT(nombre) DO NOTHING</sql:update>
<sql:update>UPDATE parcial_julian.anteproyectos SET codigo='ANT-' || LPAD(id::TEXT,5,'0') WHERE codigo IS NULL</sql:update>

<sql:update>INSERT INTO parcial_julian.usuarios(nombre,correo,rol,programa,sal,clave_hash,creditos,metodologia,nivel,plan) SELECT 'Estudiante colaborador de ejemplo','colaborador.julian@ejemplo.test','ESTUDIANTE','Ingeniería de Sistemas',md5('colaborador.julian@ejemplo.test'),encode(sha256(convert_to(md5('colaborador.julian@ejemplo.test') || 'Julian2026UTS!','UTF8')),'hex'),85,TRUE,'PROFESIONAL','ANTERIOR' WHERE NOT EXISTS(SELECT 1 FROM parcial_julian.usuarios WHERE correo='colaborador.julian@ejemplo.test')</sql:update>
<sql:update>UPDATE parcial_julian.usuarios SET creditos=85,metodologia=TRUE,nivel='PROFESIONAL',plan='ANTERIOR' WHERE correo='julian.lache@ejemplo.test' AND creditos=0 AND nivel IS NULL</sql:update>
<sql:update>INSERT INTO parcial_julian.anteproyectos(codigo,estudiante_id,director_id,evaluador_id,titulo,resumen,objetivos,justificacion,objetivos_especificos,resultados_esperados,estado,periodo_id,modalidad) SELECT 'ANT-DEMO-01',e.id,d.id,v.id,'Plataforma para control de tutorías académicas','Diseño de una plataforma para documentar reuniones de asesoría y avances del proceso de grado.','Centralizar el seguimiento académico para mejorar la comunicación entre estudiante, director y evaluador.','Se requiere un registro ordenado de revisiones y compromisos.','Diseñar módulos de seguimiento; definir indicadores de gestión.','Prototipo funcional y documento de anteproyecto.','PENDIENTE_DIRECTOR',p.id,'Desarrollo Tecnológico' FROM parcial_julian.usuarios e JOIN parcial_julian.usuarios d ON d.correo='director.julian@ejemplo.test' JOIN parcial_julian.usuarios v ON v.correo='evaluador.julian@ejemplo.test' JOIN parcial_julian.periodos p ON p.nombre='2026-2' WHERE e.correo='julian.lache@ejemplo.test' AND NOT EXISTS(SELECT 1 FROM parcial_julian.anteproyectos WHERE codigo='ANT-DEMO-01')</sql:update>
<sql:update>INSERT INTO parcial_julian.anteproyectos(codigo,estudiante_id,director_id,evaluador_id,titulo,resumen,objetivos,justificacion,estado,periodo_id,modalidad) SELECT 'ANT-DEMO-02',e.id,d.id,v.id,'Herramienta de organización de documentos de investigación','Propuesta para organizar la información de investigaciones académicas por grupos y líneas.','Implementar un repositorio académico para anteproyectos.','Necesidad de conservar versiones y documentos.','PENDIENTE_EVALUADOR',p.id,'Proyecto de Investigación' FROM parcial_julian.usuarios e JOIN parcial_julian.usuarios d ON d.correo='director.julian@ejemplo.test' JOIN parcial_julian.usuarios v ON v.correo='evaluador.julian@ejemplo.test' JOIN parcial_julian.periodos p ON p.nombre='2026-2' WHERE e.correo='julian.lache@ejemplo.test' AND NOT EXISTS(SELECT 1 FROM parcial_julian.anteproyectos WHERE codigo='ANT-DEMO-02')</sql:update>
<sql:update>INSERT INTO parcial_julian.anteproyectos(codigo,estudiante_id,director_id,evaluador_id,titulo,resumen,objetivos,estado,periodo_id,modalidad,calificacion) SELECT 'ANT-DEMO-03',e.id,d.id,v.id,'Dashboard de indicadores de permanencia estudiantil','Sistema de visualización de indicadores para el acompañamiento estudiantil.','Desarrollar un tablero académico que permita interpretar tendencias de permanencia.','APROBADO',p.id,'Desarrollo Tecnológico',4.4 FROM parcial_julian.usuarios e JOIN parcial_julian.usuarios d ON d.correo='director.julian@ejemplo.test' JOIN parcial_julian.usuarios v ON v.correo='evaluador.julian@ejemplo.test' JOIN parcial_julian.periodos p ON p.nombre='2026-2' WHERE e.correo='julian.lache@ejemplo.test' AND NOT EXISTS(SELECT 1 FROM parcial_julian.anteproyectos WHERE codigo='ANT-DEMO-03')</sql:update>
<sql:update>INSERT INTO parcial_julian.anteproyectos(codigo,estudiante_id,titulo,resumen,objetivos,estado,periodo_id,modalidad) SELECT 'ANT-DEMO-04',e.id,'Propuesta inicial de asistencia a laboratorios','Descripción inicial del sistema de control de préstamos y equipos para laboratorios universitarios.','Desarrollar una solución digital de control de inventario de laboratorio.','BORRADOR',p.id,'Desarrollo Tecnológico' FROM parcial_julian.usuarios e JOIN parcial_julian.periodos p ON p.nombre='2026-2' WHERE e.correo='julian.lache@ejemplo.test' AND NOT EXISTS(SELECT 1 FROM parcial_julian.anteproyectos WHERE codigo='ANT-DEMO-04')</sql:update>
<sql:update>INSERT INTO parcial_julian.revisiones(anteproyecto_id,revisor_id,tipo,decision,nota,observaciones) SELECT p.id,u.id,'DIRECTOR','APROBADO',4.3,'Observación de demostración: propuesta avalada para concepto del evaluador.' FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios u ON u.correo='director.julian@ejemplo.test' WHERE p.codigo IN ('ANT-DEMO-02','ANT-DEMO-03') AND NOT EXISTS(SELECT 1 FROM parcial_julian.revisiones r WHERE r.anteproyecto_id=p.id AND r.tipo='DIRECTOR')</sql:update>
<sql:update>INSERT INTO parcial_julian.revisiones(anteproyecto_id,revisor_id,tipo,decision,nota,observaciones) SELECT p.id,u.id,'EVALUADOR','APROBADO',4.4,'Observación de demostración: evaluación satisfactoria.' FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios u ON u.correo='evaluador.julian@ejemplo.test' WHERE p.codigo='ANT-DEMO-03' AND NOT EXISTS(SELECT 1 FROM parcial_julian.revisiones r WHERE r.anteproyecto_id=p.id AND r.tipo='EVALUADOR')</sql:update>
<sql:update>INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) SELECT p.id,u.id,'Registro demostrativo','Se cargó un expediente de ejemplo para probar la navegación por roles.' FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios u ON u.correo='julian.lache@ejemplo.test' WHERE p.codigo LIKE 'ANT-DEMO-%' AND NOT EXISTS(SELECT 1 FROM parcial_julian.historial h WHERE h.anteproyecto_id=p.id AND h.evento='Registro demostrativo')</sql:update>

<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.practicas (
 id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
 estudiante_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id),
 tutor_id BIGINT REFERENCES parcial_julian.usuarios(id),
 empresa VARCHAR(180) NOT NULL,
 area VARCHAR(130) NOT NULL,
 supervisor VARCHAR(160),
 contacto VARCHAR(180),
 titulo VARCHAR(220) NOT NULL,
 objetivo TEXT NOT NULL,
 inicio DATE,
 fin DATE,
 estado VARCHAR(26) NOT NULL DEFAULT 'REGISTRADA' CHECK(estado IN('REGISTRADA','EN_REVISION','APROBADA','EN_CURSO','INFORME_ENTREGADO','FINALIZADA','DEVUELTA')),
 informe_url VARCHAR(900),
 creado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
 actualizado_en TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
 CONSTRAINT practica_fechas CHECK(fin IS NULL OR inicio IS NULL OR fin>=inicio)
)</sql:update>
<sql:update>CREATE TABLE IF NOT EXISTS parcial_julian.practicas_seguimientos (
 id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
 practica_id BIGINT NOT NULL REFERENCES parcial_julian.practicas(id) ON DELETE RESTRICT,
 usuario_id BIGINT NOT NULL REFERENCES parcial_julian.usuarios(id),
 tipo VARCHAR(24) NOT NULL CHECK(tipo IN('AVANCE','RETROALIMENTACION','DECISION','INFORME')),
 detalle TEXT NOT NULL,
 evidencia_url VARCHAR(900),
 fecha TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP
)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_practicas_estudiante ON parcial_julian.practicas(estudiante_id,estado)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_practicas_tutor ON parcial_julian.practicas(tutor_id,estado)</sql:update>
<sql:update>CREATE INDEX IF NOT EXISTS idx_julian_practicas_seguimiento ON parcial_julian.practicas_seguimientos(practica_id,fecha)</sql:update>

