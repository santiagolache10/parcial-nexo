<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/panel.jsp"/></c:if>

<sql:query var="prop" dataSource="${db}">SELECT id,titulo,estado FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT)<sql:param value="${empty param.id?'0':param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query><c:if test="${prop.rowCount eq 0}"><c:redirect url="/anteproyectos.jsp"/></c:if>
<c:if test="${pageContext.request.method eq 'POST' and param.csrf eq sessionScope.csrf and prop.rows[0].estado eq 'BORRADOR'}"><c:catch var="errIntegrante"><c:choose><c:when test="${param.accion eq 'agregar'}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.integrantes(anteproyecto_id,estudiante_id) SELECT CAST(? AS BIGINT),u.id FROM parcial_julian.usuarios u WHERE lower(u.correo)=lower(CAST(? AS TEXT)) AND u.rol='ESTUDIANTE' AND u.activo=TRUE AND u.id != CAST(? AS BIGINT) AND (SELECT count(*) FROM parcial_julian.integrantes WHERE anteproyecto_id=CAST(? AS BIGINT)) < 1 ON CONFLICT(anteproyecto_id,estudiante_id) DO NOTHING
<sql:param value="${prop.rows[0].id}"/><sql:param value="${param.correo}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${prop.rows[0].id}"/></sql:update></c:when>
<c:when test="${param.accion eq 'retirar'}"><sql:update dataSource="${db}">DELETE FROM parcial_julian.integrantes WHERE anteproyecto_id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT)<sql:param value="${prop.rows[0].id}"/><sql:param value="${param.estudiante}"/></sql:update></c:when></c:choose></c:catch><c:if test="${empty errIntegrante}"><c:redirect url="/integrantes.jsp"><c:param name="id" value="${param.id}"/><c:param name="ok" value="1"/></c:redirect></c:if></c:if>
<sql:query var="integrantes" dataSource="${db}">SELECT i.estudiante_id,u.nombre,u.correo FROM parcial_julian.integrantes i JOIN parcial_julian.usuarios u ON u.id=i.estudiante_id WHERE i.anteproyecto_id=CAST(? AS BIGINT)<sql:param value="${prop.rows[0].id}"/></sql:query>
<c:set var="titulo" value="Integrantes del anteproyecto"/><c:set var="subtitulo" value="Gestiona el estudiante adicional mientras la entrega sigue en borrador."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<section class="panel"><h2><c:out value="${prop.rows[0].titulo}"/></h2><p class="info-note">Se admite un titular y un acompañante en esta versión académica. La Coordinación debe validar la conformación oficial del equipo.</p>
<c:if test="${prop.rows[0].estado eq 'BORRADOR'}"><form class="form-grid" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="id" value="${prop.rows[0].id}"/><input type="hidden" name="accion" value="agregar"/><label>Correo institucional del compañero<input type="email" name="correo" required/></label><div style="align-self:end"><button class="primary">Vincular estudiante</button></div></form></c:if>
<div class="table-wrap" style="margin-top:20px"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Acción</th></tr></thead><tbody><c:forEach items="${integrantes.rows}" var="i"><tr><td><c:out value="${i.nombre}"/></td><td><c:out value="${i.correo}"/></td><td><c:if test="${prop.rows[0].estado eq 'BORRADOR'}"><form method="post" data-confirm="¿Retirar integrante?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="accion" value="retirar"/><input type="hidden" name="id" value="${prop.rows[0].id}"/><input type="hidden" name="estudiante" value="${i.estudiante_id}"/><button class="btn small danger">Retirar</button></form></c:if></td></tr></c:forEach></tbody></table></div></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>
