<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'COORDINACION'}"><c:redirect url="/panel.jsp"/></c:if>

<c:if test="${pageContext.request.method eq 'POST' and param.csrf eq sessionScope.csrf and not empty param.id}"><c:catch var="errorDecision"><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'FINALIZADO' ELSE 'DEVUELTO_FINAL' END, etapa_actual=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'PROYECTO_FINAL_APROBADO' ELSE 'PROYECTO_FINAL' END, actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estado='APROBADO_FINAL'<sql:param value="${param.decision}"/><sql:param value="${param.decision}"/><sql:param value="${param.id}"/></sql:update>
<c:if test="${cantidad gt 0}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.decisiones(anteproyecto_id,coordinador_id,decision,acta,fecha_acta,observaciones) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),?, ?,CAST(NULLIF(CAST(? AS TEXT),'') AS DATE),?)<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.decision}"/><sql:param value="${param.acta}"/><sql:param value="${param.fecha}"/><sql:param value="${param.observaciones}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="decisiones"/><sql:param value="${param.accion}"/><sql:param value="${param.decision}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),'Decisión final de Coordinación',?)<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.decision}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT estudiante_id,id,'Coordinación registró una decisión sobre tu proyecto final.' FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT)<sql:param value="${param.id}"/></sql:update></c:if></c:catch><c:if test="${empty errorDecision}"><c:redirect url="/decisiones.jsp?ok=1"/></c:if></c:if>
<sql:query var="pendientes" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.calificacion,s.nombre AS estudiante FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id WHERE p.estado='APROBADO_FINAL' ORDER BY p.actualizado_en DESC</sql:query>
<sql:query var="historico" dataSource="${db}">SELECT d.*,p.titulo,u.nombre AS responsable FROM parcial_julian.decisiones d JOIN parcial_julian.anteproyectos p ON p.id=d.anteproyecto_id JOIN parcial_julian.usuarios u ON u.id=d.coordinador_id ORDER BY d.fecha DESC LIMIT 60</sql:query>
<c:set var="titulo" value="Decisiones de Coordinación"/><c:set var="subtitulo" value="Formalización posterior al aval de Director y Evaluador."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><c:if test="${not empty errorDecision}"><div class="alert bad">No se pudo registrar la decisión. Revisa los datos y el estado del proyecto.</div></c:if><c:if test="${param.ok eq '1'}"><div class="alert good">Decisión guardada correctamente.</div></c:if>
<section class="panel"><h2>Anteproyectos pendientes de decisión</h2><c:forEach items="${pendientes.rows}" var="p"><div class="link-card"><div style="flex:1"><strong><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></strong><p class="muted"><c:out value="${p.estudiante}"/> · Nota <c:out value="${p.calificacion}"/></p><form method="post" class="form-grid" data-confirm="¿Registrar la decisión académica?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="id" value="${p.id}"/><label>Decisión<select name="decision"><option value="APROBADO">Aprobar</option><option value="DEVUELTO">Devolver</option></select></label><label>Número de acta<input name="acta" maxlength="90" placeholder="Acta (opcional)"/></label><label>Fecha de acta<input type="date" name="fecha"/></label><label class="span2">Observaciones<textarea name="observaciones" required rows="2"></textarea></label><div class="span2"><button class="primary">Registrar decisión</button></div></form></div></div></c:forEach><c:if test="${pendientes.rowCount eq 0}"><p class="empty-note">No hay anteproyectos pendientes de una decisión final.</p></c:if></section>
<section class="panel"><h2>Decisiones emitidas</h2><div class="table-wrap"><table><thead><tr><th>Anteproyecto</th><th>Decisión</th><th>Acta</th><th>Responsable</th><th>Fecha</th></tr></thead><tbody><c:forEach items="${historico.rows}" var="d"><tr><td><c:out value="${d.titulo}"/></td><td><c:out value="${d.decision}"/></td><td><c:out value="${d.acta}"/></td><td><c:out value="${d.responsable}"/></td><td><fmt:formatDate value="${d.fecha}" pattern="dd/MM/yyyy"/></td></tr></c:forEach></tbody></table></div></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>
