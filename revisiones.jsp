<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'DIRECTOR' and sessionScope.rol ne 'EVALUADOR'}"><c:redirect url="/panel.jsp"/></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'calificar'}"><c:catch var="errorRevision">
<c:choose>
<c:when test="${sessionScope.rol eq 'DIRECTOR' and param.etapa eq 'PROYECTO_FINAL'}"><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'PENDIENTE_EVALUADOR_FINAL' ELSE 'DEVUELTO_FINAL' END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND director_id=CAST(? AS BIGINT) AND estado='PENDIENTE_DIRECTOR_FINAL' AND etapa_actual='PROYECTO_FINAL'<sql:param value="${param.decision}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'EVALUADOR' and param.etapa eq 'PROYECTO_FINAL'}"><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'APROBADO_FINAL' ELSE 'DEVUELTO_FINAL' END,calificacion_final=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN CAST(? AS NUMERIC) ELSE calificacion_final END,etapa_actual=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'PROYECTO_FINAL_APROBADO' ELSE 'PROYECTO_FINAL' END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND evaluador_id=CAST(? AS BIGINT) AND estado='PENDIENTE_EVALUADOR_FINAL' AND etapa_actual='PROYECTO_FINAL'<sql:param value="${param.decision}"/><sql:param value="${param.decision}"/><sql:param value="${param.nota}"/><sql:param value="${param.decision}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'DIRECTOR'}"><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'PENDIENTE_EVALUADOR' ELSE 'DEVUELTO' END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND director_id=CAST(? AS BIGINT) AND estado='PENDIENTE_DIRECTOR' AND etapa_actual='ANTEPROYECTO'<sql:param value="${param.decision}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:otherwise><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'APROBADO' ELSE 'DEVUELTO' END,calificacion=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN CAST(? AS NUMERIC) ELSE calificacion END,etapa_actual=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'ANTEPROYECTO_APROBADO' ELSE 'ANTEPROYECTO' END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND evaluador_id=CAST(? AS BIGINT) AND estado='PENDIENTE_EVALUADOR' AND etapa_actual='ANTEPROYECTO'<sql:param value="${param.decision}"/><sql:param value="${param.decision}"/><sql:param value="${param.nota}"/><sql:param value="${param.decision}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:otherwise></c:choose>
<c:if test="${cantidad gt 0}"><sql:update dataSource="${db}">UPDATE parcial_julian.anteproyectos SET fecha_director=CASE WHEN CAST(? AS TEXT)='DIRECTOR' THEN CURRENT_TIMESTAMP ELSE fecha_director END,fecha_evaluador=CASE WHEN CAST(? AS TEXT)='EVALUADOR' THEN CURRENT_TIMESTAMP ELSE fecha_evaluador END WHERE id=CAST(? AS BIGINT)<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.revisiones(anteproyecto_id,revisor_id,tipo,decision,nota,observaciones,etapa) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(NULLIF(CAST(? AS TEXT),'') AS NUMERIC),?,CASE WHEN CAST(? AS TEXT)='PROYECTO_FINAL' THEN 'PROYECTO_FINAL' ELSE 'ANTEPROYECTO' END)<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${param.decision}"/><sql:param value="${param.nota}"/><sql:param value="${param.observaciones}"/><sql:param value="${param.etapa}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),'revisiones','calificar',?)<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.etapa}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),CASE WHEN CAST(? AS TEXT)='PROYECTO_FINAL' THEN 'Evaluación de proyecto final' ELSE 'Evaluación de anteproyecto' END,CAST(? AS TEXT))<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.etapa}"/><sql:param value="${param.decision}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT estudiante_id,id,CASE WHEN CAST(? AS TEXT)='PROYECTO_FINAL' THEN CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'Tu proyecto final recibió una aprobación.' ELSE 'Tu proyecto final fue devuelto con observaciones.' END ELSE CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'Tu anteproyecto recibió una aprobación.' ELSE 'Tu anteproyecto fue devuelto con observaciones.' END END FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT)<sql:param value="${param.etapa}"/><sql:param value="${param.decision}"/><sql:param value="${param.decision}"/><sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT evaluador_id,id,CASE WHEN CAST(? AS TEXT)='PROYECTO_FINAL' THEN 'El director aprobó el proyecto final; ya puedes revisarlo.' ELSE 'El director aprobó el anteproyecto; ya puedes revisarlo.' END FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT) AND CAST(? AS TEXT)='DIRECTOR' AND evaluador_id IS NOT NULL AND estado IN ('PENDIENTE_EVALUADOR','PENDIENTE_EVALUADOR_FINAL')<sql:param value="${param.etapa}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/></sql:update></c:if>
</c:catch><c:if test="${empty errorRevision}"><c:redirect url="/revisiones.jsp?ok=1"/></c:if></c:if>
<sql:query var="asignados" dataSource="${db}">SELECT p.id,p.titulo,p.resumen,p.objetivos,p.enlace_archivo,p.proyecto_final_url,p.etapa_actual,p.estado,s.nombre AS estudiante FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id WHERE (CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT)) ORDER BY p.actualizado_en DESC
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Revisión de anteproyectos y proyectos finales"/><c:set var="subtitulo" value="Registra el concepto y la calificación para continuar el proceso académico."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${param.ok eq '1'}"><div class="alert good">Evaluación registrada.</div></c:if><c:if test="${not empty errorRevision}"><div class="alert bad"><strong>No se pudo completar la evaluación.</strong><br>Detalle técnico: <c:out value="${errorRevision.message}" default="Error sin mensaje; revisa catalina y localhost logs."/></div></c:if>
<c:forEach items="${asignados.rows}" var="p"><div class="panel review-card"><div class="panel-head"><div><span class="eyebrow accent"><c:out value="${p.etapa_actual eq 'PROYECTO_FINAL' or p.etapa_actual eq 'PROYECTO_FINAL_APROBADO' ? 'PROYECTO FINAL' : 'ANTEPROYECTO'}"/> #<c:out value="${p.id}"/></span><h2><c:out value="${p.titulo}"/></h2><p>Estudiante: <c:out value="${p.estudiante}"/></p></div><span class="chip"><c:out value="${p.estado}"/></span></div><div class="review-body"><div><strong>Descripción</strong><p><c:out value="${p.resumen}"/></p><strong>Objetivos</strong><p><c:out value="${p.objetivos}"/></p><c:choose><c:when test="${p.estado eq 'PENDIENTE_DIRECTOR_FINAL' or p.estado eq 'PENDIENTE_EVALUADOR_FINAL' or p.estado eq 'DEVUELTO_FINAL' or p.estado eq 'APROBADO_FINAL'}"><c:if test="${not empty p.proyecto_final_url and (fn:startsWith(p.proyecto_final_url, 'https://') or fn:startsWith(p.proyecto_final_url, 'http://'))}"><a href="<c:out value='${p.proyecto_final_url}'/>" target="_blank" rel="noopener noreferrer">Ver proyecto final ↗</a></c:if></c:when><c:otherwise><c:if test="${fn:startsWith(p.enlace_archivo, 'https://') or fn:startsWith(p.enlace_archivo, 'http://')}"><a href="<c:out value='${p.enlace_archivo}'/>" target="_blank" rel="noopener noreferrer">Ver anteproyecto ↗</a></c:if></c:otherwise></c:choose></div>
<div><c:choose><c:when test="${(sessionScope.rol eq 'DIRECTOR' and (p.estado eq 'PENDIENTE_DIRECTOR' or p.estado eq 'PENDIENTE_DIRECTOR_FINAL')) or (sessionScope.rol eq 'EVALUADOR' and (p.estado eq 'PENDIENTE_EVALUADOR' or p.estado eq 'PENDIENTE_EVALUADOR_FINAL'))}"><form class="stack" method="post" data-confirm="¿Registrar esta evaluación? La decisión se enviará al siguiente rol."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="calificar"><input type="hidden" name="id" value="${p.id}"><input type="hidden" name="etapa" value="${p.estado eq 'PENDIENTE_DIRECTOR_FINAL' or p.estado eq 'PENDIENTE_EVALUADOR_FINAL' ? 'PROYECTO_FINAL' : 'ANTEPROYECTO'}"><label>Decisión<select name="decision" required><option value="APROBADO">Aprobar</option><option value="DEVUELTO">Devolver con observaciones</option></select></label><label>Calificación (0 a 5)<input type="number" name="nota" min="0" max="5" step="0.1" required placeholder="4.5"></label><label>Observaciones<textarea name="observaciones" required rows="4" placeholder="Escribe la retroalimentación"></textarea></label><button class="primary" type="submit">Registrar evaluación →</button></form></c:when><c:otherwise><div class="empty-note">Esta entrega no está pendiente de tu revisión actualmente.</div></c:otherwise></c:choose><a class="btn ghost" href="<c:url value='/detalle.jsp'><c:param name='id' value='${p.id}'/></c:url>">Historial y calificaciones</a></div></div></div></c:forEach>
<c:if test="${asignados.rowCount eq 0}"><div class="panel empty-note">No tienes anteproyectos o proyectos finales asignados todavía.</div></c:if>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
