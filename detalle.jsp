<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<sql:query var="proyecto" dataSource="${db}">SELECT p.*,s.nombre AS estudiante,d.nombre AS director,e.nombre AS evaluador,i.titulo AS idea FROM parcial_julian.anteproyectos p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id LEFT JOIN parcial_julian.usuarios d ON d.id=p.director_id LEFT JOIN parcial_julian.usuarios e ON e.id=p.evaluador_id LEFT JOIN parcial_julian.ideas i ON i.id=p.idea_id WHERE p.id=CAST(? AS BIGINT) AND (CAST(? AS TEXT) IN ('ADMINISTRADOR','COORDINACION') OR (CAST(? AS TEXT)='ESTUDIANTE' AND p.estudiante_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT)))
<sql:param value="${empty param.id ? '0':param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:if test="${proyecto.rowCount eq 0}"><c:redirect url="/panel.jsp"/></c:if>
<sql:query var="revisiones" dataSource="${db}">SELECT r.*,u.nombre AS autor FROM parcial_julian.revisiones r JOIN parcial_julian.usuarios u ON u.id=r.revisor_id WHERE r.anteproyecto_id=CAST(? AS BIGINT) ORDER BY r.fecha DESC<sql:param value="${param.id}"/></sql:query>
<sql:query var="historial" dataSource="${db}">SELECT h.*,u.nombre AS autor FROM parcial_julian.historial h LEFT JOIN parcial_julian.usuarios u ON u.id=h.actor_id WHERE h.anteproyecto_id=CAST(? AS BIGINT) ORDER BY h.fecha DESC<sql:param value="${param.id}"/></sql:query>
<sql:query var="docs" dataSource="${db}">SELECT nombre,tipo,url,version,fecha FROM parcial_julian.documentos WHERE anteproyecto_id=CAST(? AS BIGINT) ORDER BY fecha DESC<sql:param value="${param.id}"/></sql:query>
<sql:query var="decisiones" dataSource="${db}">SELECT decision,acta,fecha_acta,observaciones,fecha FROM parcial_julian.decisiones WHERE anteproyecto_id=CAST(? AS BIGINT) ORDER BY fecha DESC<sql:param value="${param.id}"/></sql:query>
<c:set var="titulo" value="Expediente del anteproyecto"/><c:set var="subtitulo" value="Registro de responsables, calificaciones e historial de cambios."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="panel"><div class="panel-head"><div><span class="eyebrow accent"><c:out value="${proyecto.rows[0].estado eq 'APROBADO_FINAL' or proyecto.rows[0].estado eq 'PENDIENTE_DIRECTOR_FINAL' or proyecto.rows[0].estado eq 'PENDIENTE_EVALUADOR_FINAL' or proyecto.rows[0].estado eq 'DEVUELTO_FINAL' ? 'PROYECTO FINAL / EXPEDIENTE' : 'ANTEPROYECTO'}"/> #<c:out value="${proyecto.rows[0].id}"/></span><h2><c:out value="${proyecto.rows[0].titulo}"/></h2></div><span class="chip green"><c:out value="${proyecto.rows[0].estado}"/></span></div>
<div class="details-grid"><div><span>Estudiante</span><strong><c:out value="${proyecto.rows[0].estudiante}"/></strong></div><div><span>Director</span><strong><c:out value="${empty proyecto.rows[0].director ? 'Por asignar':proyecto.rows[0].director}"/></strong></div><div><span>Evaluador</span><strong><c:out value="${empty proyecto.rows[0].evaluador ? 'Por asignar':proyecto.rows[0].evaluador}"/></strong></div><div><span>Calificación final</span><strong><c:out value="${empty proyecto.rows[0].calificacion ? 'Aún no publicada':proyecto.rows[0].calificacion}"/></strong></div></div>
<div class="actions"><a class="btn primary" href="<c:url value='/seguimiento.jsp'><c:param name='id' value='${param.id}'/></c:url>">Ver seguimiento</a><a class="btn" href="<c:url value='/documentos.jsp'><c:param name='id' value='${param.id}'/></c:url>">Documentos</a><a class="btn" href="<c:url value='/versiones.jsp'><c:param name='id' value='${param.id}'/></c:url>">Versiones</a></div><hr><h3>Descripción</h3><p class="preserve"><c:out value="${proyecto.rows[0].resumen}"/></p><h3>Objetivos</h3><p class="preserve"><c:out value="${proyecto.rows[0].objetivos}"/></p>
<c:if test="${fn:startsWith(proyecto.rows[0].enlace_archivo, 'https://') or fn:startsWith(proyecto.rows[0].enlace_archivo, 'http://')}"><a class="btn" rel="noopener noreferrer" target="_blank" href="<c:out value='${proyecto.rows[0].enlace_archivo}'/>">Consultar documento ↗</a></c:if><c:if test="${not empty proyecto.rows[0].proyecto_final_url and (fn:startsWith(proyecto.rows[0].proyecto_final_url, 'https://') or fn:startsWith(proyecto.rows[0].proyecto_final_url, 'http://'))}"><a class="btn primary" rel="noopener noreferrer" target="_blank" href="<c:out value='${proyecto.rows[0].proyecto_final_url}'/>">Consultar proyecto final ↗</a></c:if></div>
<div class="split"><div class="panel"><h2>Calificaciones y observaciones</h2><c:forEach items="${revisiones.rows}" var="r"><div class="timeline"><span class="dot"></span><div><strong><c:out value="${r.tipo}"/> · <c:out value="${r.decision}"/></strong><p><c:out value="${r.autor}"/> · Nota <c:out value="${r.nota}"/></p><p class="preserve"><c:out value="${r.observaciones}"/></p><small><fmt:formatDate value="${r.fecha}" pattern="dd/MM/yyyy HH:mm"/></small></div></div></c:forEach><c:if test="${revisiones.rowCount eq 0}"><div class="empty-note">Todavía no existen evaluaciones para esta entrega.</div></c:if></div>
<div class="panel"><h2>Trazabilidad</h2><c:forEach items="${historial.rows}" var="h"><div class="timeline"><span class="dot"></span><div><strong><c:out value="${h.evento}"/></strong><p><c:out value="${h.detalle}"/></p><small><c:out value="${h.autor}"/> · <fmt:formatDate value="${h.fecha}" pattern="dd/MM/yyyy HH:mm"/></small></div></div></c:forEach><c:if test="${historial.rowCount eq 0}"><div class="empty-note">No hay movimientos registrados todavía.</div></c:if></div></div>
<section class="panel"><h2>Documentos y soportes</h2><div class="table-wrap"><table><thead><tr><th>Documento</th><th>Tipo</th><th>Versión</th><th>Consulta</th></tr></thead><tbody><c:forEach items="${docs.rows}" var="d"><tr><td><c:out value="${d.nombre}"/></td><td><c:out value="${d.tipo}"/></td><td><c:out value="${d.version}"/></td><td><a href="<c:out value='${d.url}'/>" target="_blank" rel="noopener noreferrer">Abrir ↗</a></td></tr></c:forEach></tbody></table></div><c:if test="${docs.rowCount eq 0}"><p class="empty-note">No hay documentos vinculados todavía.</p></c:if></section>
<section class="panel"><h2>Decisiones de Coordinación</h2><c:forEach items="${decisiones.rows}" var="d"><div class="link-card"><div><span class="chip"><c:out value="${d.decision}"/></span><p><c:out value="${d.observaciones}"/></p><span>Acta: <c:out value="${d.acta}" default="No registrada"/></span></div></div></c:forEach><c:if test="${decisiones.rowCount eq 0}"><p class="empty-note">Todavía no hay una decisión de Coordinación.</p></c:if></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>
