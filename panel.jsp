<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<sql:query var="conteoProyectos" dataSource="${db}">SELECT COUNT(*) AS total FROM parcial_julian.anteproyectos</sql:query>
<sql:query var="conteoIdeas" dataSource="${db}">SELECT COUNT(*) AS total FROM parcial_julian.ideas WHERE estado='DISPONIBLE'</sql:query>
<sql:query var="conteoRevisiones" dataSource="${db}">SELECT COUNT(*) AS total FROM parcial_julian.revisiones</sql:query>
<c:set var="titulo" value="Panel académico"/><c:set var="subtitulo" value="Consulta y administra el avance de los anteproyectos según tu rol."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<div class="welcome-banner"><div><span class="eyebrow">BIENVENIDO AL SISTEMA</span><h2>Hola, <c:out value="${sessionScope.nombre}"/>.</h2><p>Visualiza el proceso de manera ordenada, desde la idea hasta la revisión final.</p></div><span class="huge-symbol">✦</span></div>
<div class="metric-grid"><div class="metric"><span>Anteproyectos registrados</span><strong><c:out value="${conteoProyectos.rows[0].total}"/></strong><small>En la plataforma</small></div><div class="metric"><span>Ideas disponibles</span><strong><c:out value="${conteoIdeas.rows[0].total}"/></strong><small>Banco académico</small></div><div class="metric"><span>Revisiones registradas</span><strong><c:out value="${conteoRevisiones.rows[0].total}"/></strong><small>Seguimiento académico</small></div></div>
<div class="section-heading"><h2>Accesos principales</h2></div><div class="feature-grid">
<c:if test="${sessionScope.rol eq 'ADMINISTRADOR'}"><a class="feature" href="<c:url value='/usuarios.jsp'/>"><b>01</b><h3>Usuarios y roles</h3><p>Registrar, consultar, editar y desactivar cuentas.</p><span>Administrar →</span></a></c:if>
<c:if test="${sessionScope.rol eq 'COORDINACION'}"><a class="feature" href="<c:url value='/ideas.jsp'/>"><b>01</b><h3>Banco de ideas</h3><p>Crear, revisar y actualizar ideas de anteproyecto.</p><span>Abrir →</span></a><a class="feature" href="<c:url value='/asignaciones.jsp'/>"><b>02</b><h3>Responsables</h3><p>Asignar director y evaluador; consultar el estado.</p><span>Asignar →</span></a><a class="feature" href="<c:url value='/reportes.jsp'/>"><b>03</b><h3>Informes de estado</h3><p>Seguimiento del estudiante, director y evaluador.</p><span>Consultar →</span></a></c:if>
<c:if test="${sessionScope.rol eq 'ESTUDIANTE'}"><a class="feature" href="<c:url value='/ideas.jsp'/>"><b>01</b><h3>Seleccionar una idea</h3><p>Explora las opciones para tu anteproyecto.</p><span>Explorar →</span></a><a class="feature" href="<c:url value='/anteproyectos.jsp'/>"><b>02</b><h3>Mis anteproyectos</h3><p>Crear, actualizar, enviar y ver las calificaciones.</p><span>Entrar →</span></a></c:if>
<c:if test="${sessionScope.rol eq 'DIRECTOR' or sessionScope.rol eq 'EVALUADOR'}"><a class="feature" href="<c:url value='/revisiones.jsp'/>"><b>01</b><h3>Bandeja de evaluación</h3><p>Consulta anteproyectos asignados, califica y responde.</p><span>Revisar →</span></a></c:if>
<a class="feature" href="<c:url value='/practicas.jsp'/>"><b>▧</b><h3>Prácticas empresariales</h3><p>Postulación, bitácora de avances y entrega de informe final con tutor académico.</p><span>Gestionar →</span></a><a class="feature" href="<c:url value='/calendario.jsp'/>"><b>◎</b><h3>Calendario académico</h3><p>Fechas de entregas y revisiones del proceso.</p><span>Consultar →</span></a><a class="feature" href="<c:url value='/formatos.jsp'/>"><b>▤</b><h3>Formatos de grado</h3><p>Documentos y recursos institucionales.</p><span>Consultar →</span></a></div>
<section class="panel" style="margin-top:24px"><h2>Herramientas para tu proceso</h2><div class="actions" style="margin-top:15px"><a class="btn" href="<c:url value='/perfil.jsp'/>">Mi perfil</a><a class="btn" href="<c:url value='/notificaciones.jsp'/>">Notificaciones</a><c:if test="${sessionScope.rol eq 'COORDINACION'}"><a class="btn" href="<c:url value='/periodos.jsp'/>">Periodos</a><a class="btn" href="<c:url value='/decisiones.jsp'/>">Decisiones</a></c:if><c:if test="${sessionScope.rol ne 'ADMINISTRADOR'}"><a class="btn" href="<c:url value='/proyectos.jsp'/>">Expedientes</a></c:if></div></section>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
