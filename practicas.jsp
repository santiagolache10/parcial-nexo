<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>

<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf}">
<c:set var="filasAfectadas" value="0"/>
<c:catch var="errorPractica">
<c:choose>
<c:when test="${sessionScope.rol eq 'ESTUDIANTE' and param.accion eq 'registrar' and not empty param.empresa and not empty param.titulo and not empty param.area and not empty param.objetivo}">
<sql:update var="filasAfectadas" dataSource="${db}">INSERT INTO parcial_julian.practicas(estudiante_id,empresa,area,supervisor,contacto,titulo,objetivo,inicio,fin) VALUES(CAST(? AS BIGINT),?,?,?,?,?,?,CAST(NULLIF(CAST(? AS TEXT),'') AS DATE),CAST(NULLIF(CAST(? AS TEXT),'') AS DATE))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.empresa}"/><sql:param value="${param.area}"/><sql:param value="${param.supervisor}"/><sql:param value="${param.contacto}"/><sql:param value="${param.titulo}"/><sql:param value="${param.objetivo}"/><sql:param value="${param.inicio}"/><sql:param value="${param.fin}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'ESTUDIANTE' and param.accion eq 'editar' and not empty param.id and not empty param.empresa and not empty param.titulo and not empty param.objetivo}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET empresa=?,area=?,supervisor=?,contacto=?,titulo=?,objetivo=?,inicio=CAST(NULLIF(CAST(? AS TEXT),'') AS DATE),fin=CAST(NULLIF(CAST(? AS TEXT),'') AS DATE),actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN('REGISTRADA','DEVUELTA')
<sql:param value="${param.empresa}"/><sql:param value="${param.area}"/><sql:param value="${param.supervisor}"/><sql:param value="${param.contacto}"/><sql:param value="${param.titulo}"/><sql:param value="${param.objetivo}"/><sql:param value="${param.inicio}"/><sql:param value="${param.fin}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'ESTUDIANTE' and param.accion eq 'enviar' and not empty param.id}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET estado='EN_REVISION',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN('REGISTRADA','DEVUELTA')
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'COORDINACION' and param.accion eq 'aprobar' and not empty param.id and not empty param.tutor}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET tutor_id=CAST(? AS BIGINT),estado='APROBADA',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estado='EN_REVISION' AND EXISTS(SELECT 1 FROM parcial_julian.usuarios u WHERE u.id=CAST(? AS BIGINT) AND u.rol='DIRECTOR' AND u.activo=TRUE)
<sql:param value="${param.tutor}"/><sql:param value="${param.id}"/><sql:param value="${param.tutor}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'COORDINACION' and param.accion eq 'devolver' and not empty param.id}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET estado='DEVUELTA',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estado='EN_REVISION'
<sql:param value="${param.id}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'DIRECTOR' and param.accion eq 'iniciar' and not empty param.id}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET estado='EN_CURSO',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND tutor_id=CAST(? AS BIGINT) AND estado='APROBADA'
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'ESTUDIANTE' and param.accion eq 'informe' and not empty param.id and not empty param.informe}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET estado='INFORME_ENTREGADO',informe_url=?,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado='EN_CURSO'
<sql:param value="${param.informe}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'DIRECTOR' and param.accion eq 'finalizar' and not empty param.id}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET estado='FINALIZADA',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND tutor_id=CAST(? AS BIGINT) AND estado='INFORME_ENTREGADO'
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${sessionScope.rol eq 'DIRECTOR' and param.accion eq 'corregir' and not empty param.id}">
<sql:update var="filasAfectadas" dataSource="${db}">UPDATE parcial_julian.practicas SET estado='EN_CURSO',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND tutor_id=CAST(? AS BIGINT) AND estado='INFORME_ENTREGADO'
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${not empty param.id and not empty param.detalle and param.accion eq 'actividad' and (sessionScope.rol eq 'ESTUDIANTE' or sessionScope.rol eq 'DIRECTOR')}">
<sql:update var="filasAfectadas" dataSource="${db}">INSERT INTO parcial_julian.practicas_seguimientos(practica_id,usuario_id,tipo,detalle,evidencia_url) SELECT p.id,CAST(? AS BIGINT),CASE WHEN CAST(? AS TEXT)='DIRECTOR' THEN 'RETROALIMENTACION' ELSE 'AVANCE' END,?,? FROM parcial_julian.practicas p WHERE p.id=CAST(? AS BIGINT) AND ((CAST(? AS TEXT)='ESTUDIANTE' AND p.estudiante_id=CAST(? AS BIGINT) AND p.estado='EN_CURSO') OR (CAST(? AS TEXT)='DIRECTOR' AND p.tutor_id=CAST(? AS BIGINT) AND p.estado IN('EN_CURSO','INFORME_ENTREGADO')))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${param.detalle}"/><sql:param value="${param.evidencia}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
</c:choose>
</c:catch>
<c:if test="${empty errorPractica and filasAfectadas gt 0}">
<c:catch var="errorBitacora"><sql:update dataSource="${db}">INSERT INTO parcial_julian.auditoria(usuario_id,entidad,entidad_id,accion,detalle) VALUES(CAST(? AS BIGINT),'practicas',CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),?,?)
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.id}"/><sql:param value="${param.accion}"/><sql:param value="${empty param.titulo ? param.detalle : param.titulo}"/></sql:update></c:catch>
<c:redirect url="/practicas.jsp?ok=1"/></c:if>
</c:if>

<sql:query var="practicas" dataSource="${db}">SELECT p.id,p.empresa,p.area,p.titulo,p.estado,p.inicio,p.fin,p.creado_en,p.estudiante_id,p.tutor_id,s.nombre AS estudiante,t.nombre AS tutor FROM parcial_julian.practicas p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id LEFT JOIN parcial_julian.usuarios t ON t.id=p.tutor_id WHERE (CAST(? AS TEXT) IN ('ADMINISTRADOR','COORDINACION') OR (CAST(? AS TEXT)='ESTUDIANTE' AND p.estudiante_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='DIRECTOR' AND p.tutor_id=CAST(? AS BIGINT))) ORDER BY p.actualizado_en DESC LIMIT 150
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<sql:query var="tutores" dataSource="${db}">SELECT id,nombre FROM parcial_julian.usuarios WHERE rol='DIRECTOR' AND activo=TRUE ORDER BY nombre</sql:query>
<c:if test="${not empty param.id}"><sql:query var="registro" dataSource="${db}">SELECT p.*,s.nombre AS estudiante,t.nombre AS tutor FROM parcial_julian.practicas p JOIN parcial_julian.usuarios s ON s.id=p.estudiante_id LEFT JOIN parcial_julian.usuarios t ON t.id=p.tutor_id WHERE p.id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT) AND (CAST(? AS TEXT) IN ('ADMINISTRADOR','COORDINACION') OR (CAST(? AS TEXT)='ESTUDIANTE' AND p.estudiante_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='DIRECTOR' AND p.tutor_id=CAST(? AS BIGINT)))
<sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query></c:if>
<c:if test="${registro.rowCount eq 1}"><c:set var="pr" value="${registro.rows[0]}"/><sql:query var="bitacora" dataSource="${db}">SELECT b.*,u.nombre AS autor FROM parcial_julian.practicas_seguimientos b JOIN parcial_julian.usuarios u ON u.id=b.usuario_id WHERE b.practica_id=CAST(? AS BIGINT) ORDER BY b.fecha DESC LIMIT 100<sql:param value="${pr.id}"/></sql:query></c:if>
<c:set var="titulo" value="Prácticas empresariales"/><c:set var="subtitulo" value="Postulación, acompañamiento de tutores y entrega del informe final."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${param.ok eq '1'}"><div class="alert good">Movimiento guardado correctamente en el módulo de prácticas.</div></c:if>
<c:if test="${not empty errorPractica}"><div class="alert bad">No se pudo guardar el cambio. Revisa las fechas y la etapa actual del proceso.</div></c:if>
<div class="practice-intro"><div><span class="eyebrow">ESTANCIAS FORMATIVAS</span><h2>Tu práctica, paso a paso.</h2><p>Registro de empresas, acompañamiento y evidencias. Un espacio independiente del seguimiento de anteproyectos.</p></div><div class="practice-emblem">▧</div></div>
<div class="practice-track"><div><span>01</span>Postulación</div><div><span>02</span>Revisión</div><div><span>03</span>Asignación</div><div><span>04</span>Desarrollo</div><div><span>05</span>Informe final</div></div>
<c:if test="${sessionScope.rol eq 'ESTUDIANTE' and (empty param.id or (pr.id gt 0 and (pr.estado eq 'REGISTRADA' or pr.estado eq 'DEVUELTA')))}"><section class="panel" id="registroPractica"><h2>${pr.id gt 0 and (pr.estado eq 'REGISTRADA' or pr.estado eq 'DEVUELTA') ? 'Editar postulación' : 'Registrar nueva práctica'}</h2><p class="muted">Este registro permanece como borrador hasta seleccionar «Enviar a Coordinación».</p>
<form method="post" class="form-grid"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="${pr.id gt 0 and (pr.estado eq 'REGISTRADA' or pr.estado eq 'DEVUELTA') ? 'editar' : 'registrar'}"><input type="hidden" name="id" value="<c:out value='${pr.id}'/>">
<label>Empresa o institución<input name="empresa" maxlength="180" required value="<c:out value='${pr.empresa}'/>" placeholder="Organización receptora"></label><label>Área de trabajo<input name="area" maxlength="130" required value="<c:out value='${pr.area}'/>" placeholder="Área o departamento"></label>
<label>Supervisor externo<input name="supervisor" maxlength="160" value="<c:out value='${pr.supervisor}'/>" placeholder="Nombre del responsable"></label><label>Correo de contacto<input name="contacto" type="email" maxlength="180" value="<c:out value='${pr.contacto}'/>" placeholder="supervisor@empresa.com"></label>
<label class="span2">Nombre de la práctica<input name="titulo" maxlength="220" required value="<c:out value='${pr.titulo}'/>" placeholder="Título de la propuesta de práctica"></label>
<label class="span2">Objetivos y actividades<textarea name="objetivo" rows="3" required><c:out value="${pr.objetivo}"/></textarea></label>
<label>Fecha inicial<input type="date" name="inicio" value="<c:out value='${pr.inicio}'/>"></label><label>Fecha final<input type="date" name="fin" value="<c:out value='${pr.fin}'/>"></label>
<div class="span2 actions"><button class="primary" type="submit">Guardar postulación</button><a class="btn ghost" href="<c:url value='/practicas.jsp'/>">Nueva postulación</a></div></form></section></c:if>
<section class="panel"><div class="search-line"><div><span class="eyebrow accent">CONTROL DE PRÁCTICAS</span><h2>Registros y seguimiento</h2></div><label>Buscar<input type="search" data-table-search="listaPracticas" placeholder="Empresa, título o estudiante"></label></div>
<div class="table-wrap"><table id="listaPracticas"><thead><tr><th>Empresa / práctica</th><th>Estudiante</th><th>Tutor</th><th>Estado</th><th>Consulta</th></tr></thead><tbody>
<c:forEach items="${practicas.rows}" var="item"><tr><td><strong><c:out value="${item.titulo}"/></strong><small class="practice-sub"><c:out value="${item.empresa}"/> · <c:out value="${item.area}"/></small></td><td><c:out value="${item.estudiante}"/></td><td><c:out value="${item.tutor}" default="Por asignar"/></td><td><span class="chip ${item.estado eq 'FINALIZADA'?'green':'gray'}"><c:out value="${item.estado}"/></span></td><td><a class="btn small" href="<c:url value='/practicas.jsp'><c:param name='id' value='${item.id}'/></c:url>">Ver detalle</a></td></tr></c:forEach>
</tbody></table></div><c:if test="${practicas.rowCount eq 0}"><p class="empty-note">No hay prácticas registradas para tu perfil. Las nuevas postulaciones aparecerán aquí.</p></c:if></section>
<c:if test="${registro.rowCount eq 1}"><section class="panel practice-detail"><div class="panel-head"><div><span class="eyebrow accent">EXPEDIENTE PRÁCTICA #<c:out value='${pr.id}'/></span><h2><c:out value="${pr.titulo}"/></h2><p class="muted"><c:out value="${pr.empresa}"/> · <c:out value="${pr.area}"/></p></div><span class="chip"><c:out value="${pr.estado}"/></span></div>
<div class="details-grid"><div><small>Estudiante</small><strong><c:out value="${pr.estudiante}"/></strong></div><div><small>Tutor académico</small><strong><c:out value="${pr.tutor}" default="Pendiente"/></strong></div><div><small>Supervisor externo</small><strong><c:out value="${pr.supervisor}" default="No registrado"/></strong></div><div><small>Fechas</small><strong><c:out value="${pr.inicio}" default="Por definir"/> — <c:out value="${pr.fin}" default="Por definir"/></strong></div></div>
<div class="actions practice-actions">
<c:if test="${sessionScope.rol eq 'ESTUDIANTE' and (pr.estado eq 'REGISTRADA' or pr.estado eq 'DEVUELTA')}"><a class="btn" href="<c:url value='/practicas.jsp'><c:param name='id' value='${pr.id}'/></c:url>#registroPractica">Editar registro</a><form class="inline" method="post" data-confirm="¿Enviar la postulación a Coordinación?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="enviar"><button class="primary">Enviar a Coordinación</button></form></c:if>
<c:if test="${sessionScope.rol eq 'COORDINACION' and pr.estado eq 'EN_REVISION'}"><form class="inline practice-review" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="aprobar"><label>Asignar tutor<select name="tutor" required><option value="">Selecciona un director</option><c:forEach items="${tutores.rows}" var="t"><option value="${t.id}"><c:out value="${t.nombre}"/></option></c:forEach></select></label><button class="primary" type="submit">Aprobar y asignar</button></form><form method="post" class="inline" data-confirm="¿Devolver la postulación al estudiante?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="devolver"><button class="btn danger" type="submit">Solicitar corrección</button></form></c:if>
<c:if test="${sessionScope.rol eq 'DIRECTOR' and pr.estado eq 'APROBADA'}"><form method="post" class="inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="iniciar"><button class="primary">Iniciar práctica</button></form></c:if>
<c:if test="${sessionScope.rol eq 'DIRECTOR' and pr.estado eq 'INFORME_ENTREGADO'}"><form method="post" class="inline" data-confirm="¿Validar el informe y finalizar la práctica?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="finalizar"><button class="primary">Validar y finalizar</button></form><form method="post" class="inline"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="corregir"><button class="btn">Devolver informe</button></form></c:if>
</div><c:if test="${sessionScope.rol eq 'ESTUDIANTE' and pr.estado eq 'EN_CURSO'}"><form class="practice-report" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="informe"><label>Enlace al informe final (Drive o repositorio)<input type="url" name="informe" pattern="https?://.*" required maxlength="900" placeholder="https://..."></label><button type="submit" class="primary">Entregar informe final</button></form></c:if>
<c:if test="${not empty pr.informe_url}"><p class="practice-file">Informe final: <a href="<c:out value='${pr.informe_url}'/>" target="_blank" rel="noopener noreferrer">Consultar documento ↗</a></p></c:if>
<hr><div class="search-line"><h3>Bitácora de acompañamiento</h3><span class="chip"><c:out value="${bitacora.rowCount}"/> registros</span></div>
<c:if test="${(sessionScope.rol eq 'ESTUDIANTE' and pr.estado eq 'EN_CURSO') or (sessionScope.rol eq 'DIRECTOR' and (pr.estado eq 'EN_CURSO' or pr.estado eq 'INFORME_ENTREGADO'))}"><form method="post" class="stack"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="id" value="${pr.id}"><input type="hidden" name="accion" value="actividad"><label>${sessionScope.rol eq 'DIRECTOR' ? 'Observación del tutor':'Descripción de las actividades'}<textarea name="detalle" required rows="3" minlength="8" placeholder="Registra el avance y el trabajo realizado"></textarea></label><label>Enlace a evidencia (opcional)<input name="evidencia" type="url" pattern="https?://.*" placeholder="https://..."></label><button class="primary" type="submit">Guardar en bitácora</button></form></c:if>
<c:choose><c:when test="${bitacora.rowCount eq 0}"><div class="empty-note">Aún no hay actividades ni retroalimentaciones registradas.</div></c:when><c:otherwise><div class="practice-feed"><c:forEach items="${bitacora.rows}" var="a"><article><div class="practice-feed-head"><strong><c:out value="${a.autor}"/></strong><span><fmt:formatDate value="${a.fecha}" pattern="dd/MM/yyyy HH:mm"/></span></div><span class="module-tag"><c:out value="${a.tipo}"/></span><p class="preserve"><c:out value="${a.detalle}"/></p><c:if test="${not empty a.evidencia_url}"><a href="<c:out value='${a.evidencia_url}'/>" target="_blank" rel="noopener noreferrer">Ver evidencia ↗</a></c:if></article></c:forEach></div></c:otherwise></c:choose>
</section></c:if>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
