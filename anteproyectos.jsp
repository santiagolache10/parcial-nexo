<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:set var="rolNecesario" value="ESTUDIANTE"/><%@ include file="/WEB-INF/jspf/roles.jspf" %>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf}"><c:catch var="errorForm"><c:choose>
<c:when test="${param.accion eq 'crear'}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.anteproyectos(idea_id,estudiante_id,titulo,resumen,objetivos,enlace_archivo,estado,modalidad,justificacion,objetivos_especificos,resultados_esperados,grupo_id,linea_id,periodo_id) VALUES(CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),CAST(? AS BIGINT),?,?,?,?,'BORRADOR',?,?,?,?,CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT))
<sql:param value="${param.idea}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.titulo}"/><sql:param value="${param.resumen}"/><sql:param value="${param.objetivos}"/><sql:param value="${param.enlace}"/><sql:param value="${param.modalidad}"/><sql:param value="${param.justificacion}"/><sql:param value="${param.objetivosEspecificos}"/><sql:param value="${param.resultados}"/><sql:param value="${param.grupo}"/><sql:param value="${param.linea}"/><sql:param value="${param.periodo}"/></sql:update></c:when>
<c:when test="${param.accion eq 'actualizar'}"><sql:update dataSource="${db}">UPDATE parcial_julian.anteproyectos SET titulo=?,resumen=?,objetivos=?,enlace_archivo=?,modalidad=?,justificacion=?,objetivos_especificos=?,resultados_esperados=?,grupo_id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),linea_id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),periodo_id=CAST(NULLIF(CAST(? AS TEXT),'') AS BIGINT),actualizado_en=CURRENT_TIMESTAMP,version_actual=version_actual+1 WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN ('BORRADOR','DEVUELTO')
<sql:param value="${param.titulo}"/><sql:param value="${param.resumen}"/><sql:param value="${param.objetivos}"/><sql:param value="${param.enlace}"/><sql:param value="${param.modalidad}"/><sql:param value="${param.justificacion}"/><sql:param value="${param.objetivosEspecificos}"/><sql:param value="${param.resultados}"/><sql:param value="${param.grupo}"/><sql:param value="${param.linea}"/><sql:param value="${param.periodo}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:when test="${param.accion eq 'eliminar'}"><sql:update dataSource="${db}">DELETE FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado='BORRADOR' AND NOT EXISTS(SELECT 1 FROM parcial_julian.revisiones WHERE anteproyecto_id=CAST(? AS BIGINT))
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.id}"/></sql:update></c:when>
<c:when test="${param.accion eq 'enviar'}"><sql:update var="cambiados" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET estado=CASE WHEN director_id IS NULL THEN 'SIN_DIRECTOR' ELSE 'PENDIENTE_DIRECTOR' END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN ('BORRADOR','DEVUELTO') AND length(trim(resumen)) >= 15 AND length(trim(objetivos)) >= 10
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update>
<c:if test="${cambiados gt 0}"><sql:update dataSource="${db}">UPDATE parcial_julian.anteproyectos SET codigo='ANT-'||LPAD(id::TEXT,5,'0') WHERE id=CAST(? AS BIGINT) AND codigo IS NULL<sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.versiones(anteproyecto_id,version,titulo,resumen,objetivos,justificacion,archivo_url,autor_id) SELECT p.id,p.version_actual,p.titulo,p.resumen,p.objetivos,p.justificacion,p.enlace_archivo,CAST(? AS BIGINT) FROM parcial_julian.anteproyectos p WHERE p.id=CAST(? AS BIGINT) ON CONFLICT(anteproyecto_id,version) DO NOTHING<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT director_id,id,'Se ha enviado un anteproyecto para tu revisión.' FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT) AND director_id IS NOT NULL<sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),'Entrega de anteproyecto','El estudiante envió su propuesta para revisión.')<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:if></c:when>
<c:when test="${param.accion eq 'final_enviar'}"><sql:update var="cambiadosFinal" dataSource="${db}">UPDATE parcial_julian.anteproyectos SET proyecto_final_url=?,version_final=version_final+1,estado='PENDIENTE_DIRECTOR_FINAL',etapa_actual='PROYECTO_FINAL',actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND ((estado='APROBADO' AND etapa_actual='ANTEPROYECTO_APROBADO') OR (estado='DEVUELTO_FINAL' AND etapa_actual='PROYECTO_FINAL')) AND director_id IS NOT NULL AND evaluador_id IS NOT NULL AND (CAST(? AS TEXT) LIKE 'https://%' OR CAST(? AS TEXT) LIKE 'http://%')<sql:param value="${param.enlaceFinal}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.enlaceFinal}"/><sql:param value="${param.enlaceFinal}"/></sql:update><c:if test="${cambiadosFinal gt 0}"><sql:update dataSource="${db}">INSERT INTO parcial_julian.documentos(anteproyecto_id,tipo,nombre,url,version,usuario_id) SELECT id,'PROYECTO_FINAL','Proyecto final',proyecto_final_url,version_final,CAST(? AS BIGINT) FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT)<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.id}"/></sql:update><sql:update dataSource="${db}">INSERT INTO parcial_julian.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),'Entrega de proyecto final','El estudiante envió el proyecto final para revisión del director y evaluador.')<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update><sql:update dataSource="${db}">INSERT INTO parcial_julian.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT director_id,id,'El estudiante entregó el proyecto final para tu revisión.' FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT)<sql:param value="${param.id}"/></sql:update></c:if></c:when>
</c:choose><sql:update dataSource="${db}">INSERT INTO parcial_julian.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="anteproyectos"/><sql:param value="${param.accion}"/><sql:param value="${param.titulo}"/></sql:update></c:catch><c:if test="${empty errorForm}"><c:redirect url="/anteproyectos.jsp?ok=1"/></c:if></c:if>
<sql:query var="propios" dataSource="${db}">SELECT p.*,d.nombre AS director,e.nombre AS evaluador,i.titulo AS idea FROM parcial_julian.anteproyectos p LEFT JOIN parcial_julian.usuarios d ON d.id=p.director_id LEFT JOIN parcial_julian.usuarios e ON e.id=p.evaluador_id LEFT JOIN parcial_julian.ideas i ON i.id=p.idea_id WHERE p.estudiante_id=CAST(? AS BIGINT) ORDER BY p.actualizado_en DESC<sql:param value="${sessionScope.idUsuario}"/></sql:query>
<sql:query var="grupos" dataSource="${db}">SELECT id,nombre FROM parcial_julian.grupos WHERE activo=TRUE ORDER BY nombre</sql:query><sql:query var="lineas" dataSource="${db}">SELECT id,nombre,grupo_id FROM parcial_julian.lineas WHERE activo=TRUE ORDER BY nombre</sql:query><sql:query var="periodos" dataSource="${db}">SELECT id,nombre FROM parcial_julian.periodos WHERE estado='ABIERTO' ORDER BY inicio DESC</sql:query>
<sql:query var="ideasDisponibles" dataSource="${db}">SELECT id,titulo FROM parcial_julian.ideas WHERE estado='DISPONIBLE' AND (desde IS NULL OR desde<=CURRENT_DATE) AND (hasta IS NULL OR hasta>=CURRENT_DATE) ORDER BY titulo</sql:query>
<c:if test="${not empty param.editar}"><sql:query var="editado" dataSource="${db}">SELECT * FROM parcial_julian.anteproyectos WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN ('BORRADOR','DEVUELTO')<sql:param value="${param.editar}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query></c:if>
<c:set var="titulo" value="Mis anteproyectos"/><c:set var="subtitulo" value="Selecciona una idea, redacta el documento y consulta su evaluación."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${param.ok eq '1'}"><div class="alert good">Operación completada correctamente.</div></c:if><c:if test="${not empty errorForm}"><div class="alert bad">No se guardó el anteproyecto. Comprueba los campos y vuelve a intentarlo.</div></c:if>
<div class="panel"><h2>${editado.rowCount gt 0 ? 'Editar anteproyecto':'Nuevo anteproyecto'}</h2><p class="muted">Al enviar, el director asignado podrá revisar el anteproyecto. Cuando director y evaluador lo aprueben, aquí aparecerá la opción para entregar el proyecto final. Cada entrega conserva su historial.</p>
<form class="form-grid" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="${editado.rowCount gt 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${editado.rows[0].id}">
<label>Idea seleccionada<select name="idea"><option value="">Idea propia</option><c:forEach items="${ideasDisponibles.rows}" var="i"><option value="${i.id}" ${param.idea eq i.id or editado.rows[0].idea_id eq i.id ? 'selected':''}><c:out value="${i.titulo}"/></option></c:forEach></select></label>
<label>Título del anteproyecto<input required maxlength="220" name="titulo" value="<c:out value='${editado.rows[0].titulo}'/>" placeholder="Título del proyecto"></label>
<label class="span2">Descripción o planteamiento del problema<textarea name="resumen" required minlength="15" rows="4"><c:out value="${editado.rows[0].resumen}"/></textarea></label>
<label class="span2">Objetivos<textarea name="objetivos" required minlength="10" rows="3"><c:out value="${editado.rows[0].objetivos}"/></textarea></label>
<label>Modalidad<select name="modalidad"><option value="Desarrollo Tecnológico" ${editado.rows[0].modalidad eq 'Desarrollo Tecnológico'?'selected':''}>Desarrollo Tecnológico</option><option value="Proyecto de Investigación" ${editado.rows[0].modalidad eq 'Proyecto de Investigación'?'selected':''}>Proyecto de Investigación</option><option value="Monografía">Monografía</option><option value="Práctica">Práctica</option><option value="Seminario">Seminario</option><option value="Emprendimiento">Emprendimiento</option></select></label>
<label>Periodo académico<select name="periodo"><option value="">Sin seleccionar</option><c:forEach items="${periodos.rows}" var="p"><option value="${p.id}" ${editado.rows[0].periodo_id eq p.id?'selected':''}><c:out value="${p.nombre}"/></option></c:forEach></select></label>
<label class="span2">Justificación<textarea name="justificacion" rows="3"><c:out value="${editado.rows[0].justificacion}"/></textarea></label>
<label class="span2">Objetivos específicos<textarea name="objetivosEspecificos" rows="3"><c:out value="${editado.rows[0].objetivos_especificos}"/></textarea></label>
<label class="span2">Resultados esperados<textarea name="resultados" rows="2"><c:out value="${editado.rows[0].resultados_esperados}"/></textarea></label>
<label>Grupo de investigación<select name="grupo"><option value="">No asignado</option><c:forEach items="${grupos.rows}" var="g"><option value="${g.id}" ${editado.rows[0].grupo_id eq g.id?'selected':''}><c:out value="${g.nombre}"/></option></c:forEach></select></label>
<label>Línea de investigación<select name="linea"><option value="">No asignada</option><c:forEach items="${lineas.rows}" var="l"><option value="${l.id}" ${editado.rows[0].linea_id eq l.id?'selected':''}><c:out value="${l.nombre}"/></option></c:forEach></select></label>
<label class="span2">Enlace al archivo del anteproyecto (Drive o repositorio)<input name="enlace" type="url" maxlength="900" placeholder="https://..." value="<c:out value='${editado.rows[0].enlace_archivo}'/>"></label>
<div class="span2 actions"><button class="primary" type="submit">Guardar borrador</button><a class="btn ghost" href="<c:url value='/anteproyectos.jsp'/>">Limpiar formulario</a></div></form></div>
<div class="panel"><div class="search-line"><h2>Mis entregas y calificaciones</h2><label>Buscar<input type="search" data-table-search="misProyectos" placeholder="Título, docente o estado"/></label></div><div class="table-wrap"><table id="misProyectos"><thead><tr><th>Anteproyecto</th><th>Responsables</th><th>Estado</th><th>Nota</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${propios.rows}" var="p"><tr><td><strong><c:out value="${p.titulo}"/></strong><small class="muted">Código #<c:out value="${p.id}"/></small></td><td>Director: <c:out value="${empty p.director ? 'Por asignar' : p.director}"/><br>Evaluador: <c:out value="${empty p.evaluador ? 'Por asignar' : p.evaluador}"/></td><td><span class="chip"><c:out value="${p.estado}"/></span></td><td><c:choose><c:when test="${not empty p.calificacion}"><fmt:formatNumber value="${p.calificacion}" minFractionDigits="1" maxFractionDigits="2"/></c:when><c:otherwise>—</c:otherwise></c:choose></td><td class="actions"><a class="btn small" href="<c:url value='/detalle.jsp'><c:param name='id' value='${p.id}'/></c:url>">Ver revisión</a><a class="btn small" href="<c:url value='/seguimiento.jsp'><c:param name='id' value='${p.id}'/></c:url>">Seguimiento</a><a class="btn small" href="<c:url value='/integrantes.jsp'><c:param name='id' value='${p.id}'/></c:url>">Equipo</a>
<c:if test="${p.estado eq 'BORRADOR' or p.estado eq 'DEVUELTO'}"><a class="btn small" href="<c:url value='/anteproyectos.jsp'><c:param name='editar' value='${p.id}'/></c:url>">Editar</a><form class="inline" method="post" data-confirm="¿Enviar a revisión?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="enviar"><input type="hidden" name="id" value="${p.id}"><button class="primary small">Enviar</button></form></c:if>
<c:if test="${p.estado eq 'BORRADOR'}"><form class="inline" method="post" data-confirm="¿Eliminar este borrador?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="id" value="${p.id}"><button class="btn danger small">Eliminar</button></form></c:if>
<c:if test="${(p.estado eq 'APROBADO' and p.etapa_actual eq 'ANTEPROYECTO_APROBADO') or (p.estado eq 'DEVUELTO_FINAL' and p.etapa_actual eq 'PROYECTO_FINAL')}"><form class="stack" method="post" style="min-width:240px;margin-top:10px" data-confirm="¿Enviar el proyecto final al director y evaluador?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="final_enviar"><input type="hidden" name="id" value="${p.id}"><label>Enlace del proyecto final<input type="url" name="enlaceFinal" required maxlength="900" placeholder="https://..." value="<c:out value='${p.proyecto_final_url}'/>"/></label><button class="primary small" type="submit">${p.estado eq 'DEVUELTO_FINAL' ? 'Reenviar proyecto final' : 'Subir proyecto final'} →</button></form></c:if>
<c:if test="${p.estado eq 'PENDIENTE_DIRECTOR_FINAL' or p.estado eq 'PENDIENTE_EVALUADOR_FINAL'}"><small class="muted">Proyecto final en revisión</small></c:if><c:if test="${p.estado eq 'APROBADO_FINAL' or p.estado eq 'FINALIZADO'}"><small class="muted">Proyecto final aprobado</small></c:if></td></tr></c:forEach>
<c:if test="${propios.rowCount eq 0}"><tr><td colspan="5">Aún no has registrado anteproyectos. Comienza con el formulario.</td></tr></c:if></tbody></table></div></div>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
